{
  "manifest_version": 3,
  "name": "AI WatchDog Browser Protection",
  "version": "1.1.3",
  "description": "Rates supported search results and checks website visits through your local AI WatchDog backend.",
  "permissions": ["tabs", "storage", "declarativeNetRequest"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": { "default_title": "AI WatchDog", "default_popup": "popup.html" },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [{
    "matches": [
      "https://google.com/search*",
      "https://www.google.com/search*",
      "https://google.co.uk/search*",
      "https://www.google.co.uk/search*",
      "https://google.ca/search*",
      "https://www.google.ca/search*",
      "https://google.com.au/search*",
      "https://www.google.com.au/search*",
      "https://bing.com/search*",
      "https://www.bing.com/search*",
      "https://duckduckgo.com/*",
      "https://html.duckduckgo.com/html/*"
    ],
    "js": ["search-results.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["warning.html", "extension.css", "warning.js", "assets/*.svg"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
