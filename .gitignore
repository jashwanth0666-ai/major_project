# Keep Risk Engine configuration
!ml_model/phase4/risk_engine_config.json

# Runtime/generated output
runtime/
output/
results/

!ml_model/phase4/
!ml_model/phase4/xgboost_calibrated.joblib
!ml_model/phase4/risk_engine_config.json

ml_model/analysis/
