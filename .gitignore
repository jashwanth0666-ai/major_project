# ============================================================
# AI WatchDog - Final .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# Java / Maven
**/target/
*.class

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs / temporary files
*.log
logs/
*.tmp
*.temp
*.bak

# Secrets
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Local databases
*.db
*.sqlite
*.sqlite3

# ============================================================
# ML DEVELOPMENT DATA - NOT REQUIRED FOR DEPLOYMENT
# ============================================================

ml_model/analysis/
ml_model/phase2/
ml_model/phase3/
ml_model/phase3_5/
ml_model/phase5/
ml_model/splits/
ml_model/phishing_master.csv

# Benchmark models
ml_model/phase3/models/

# ============================================================
# Keep ONLY Phase 4 deployment artifacts
# ============================================================

# Ignore model artifacts by default
*.joblib
*.pkl
*.pickle

# Un-ignore the production/deployment model
!ml_model/phase4/
