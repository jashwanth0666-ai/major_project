# Keep Risk Engine configuration
!data/phase4/risk_engine_config.json

# Runtime/generated output
runtime/
output/
results/

!data/phase4/
!data/phase4/xgboost_calibrated.joblib
!data/phase4/risk_engine_config.json

data/analysis/
