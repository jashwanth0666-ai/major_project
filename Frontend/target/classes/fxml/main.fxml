                      </StackPane>
                      <Label fx:id="step1Label" text="Initializing scan" styleClass="wd-stp-label-pending"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="wd-stp-row">
                      <StackPane fx:id="step2IconBox" styleClass="wd-stp-box-pending">
                        <FontIcon fx:id="step2Icon" iconLiteral="fth-check" iconSize="14" iconColor="#10B981" visible="false"/>
                      </StackPane>
                      <Label fx:id="step2Label" text="URL integrity check" styleClass="wd-stp-label-pending"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="wd-stp-row">
