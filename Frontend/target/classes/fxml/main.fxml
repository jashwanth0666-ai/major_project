                      </StackPane>
                      <Label fx:id="step3Label" text="Extracting features" styleClass="wd-stp-label-pending"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="wd-stp-row">
                      <StackPane fx:id="step4IconBox" styleClass="wd-stp-box-pending">
