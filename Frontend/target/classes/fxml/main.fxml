                    <Region HBox.hgrow="ALWAYS"/>
                  </HBox>
                </VBox>

                <!-- Right Column: AI Recommendations & How AI Detects Threats -->
                <VBox GridPane.columnIndex="1" spacing="16">
                  <!-- AI Recommendations -->
                  <VBox styleClass="stitch-card" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <FontIcon iconLiteral="fth-zap" iconSize="16" iconColor="#2563EB"/>
                      <Label text="AI-Generated Insights" styleClass="wd-section-title"/>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Button text="Generate" onAction="#refreshAiInsights" styleClass="stitch-btn-secondary, wd-btn, wd-tonal, wd-btn--tonal"/>
                    </HBox>
                    <Label fx:id="aiInsightSource" text="Generated from full-period aggregate telemetry" styleClass="breakdown-sub"/>
                    <Label fx:id="aiInsightMetadata" text="Period sample and generation time will appear here." styleClass="breakdown-sub" wrapText="true"/>
                    <Label fx:id="aiInsightSummary" text="Open this section to generate an insight from recent phishing assessments and feedback." styleClass="wd-rec-title" wrapText="true"/>
                    <Label fx:id="aiInsightEvidence" text="Evidence will be shown here." styleClass="breakdown-sub" wrapText="true"/>
                    <Button fx:id="aiInsightReviewButton" text="Review linked feedback case" onAction="#reviewInsightFeedback" visible="false" managed="false" styleClass="stitch-btn-secondary, wd-btn, wd-tonal, wd-btn--tonal"/>
                    <HBox spacing="8" alignment="TOP_LEFT" styleClass="table-row-item">
                      <FontIcon iconLiteral="fth-shield" iconSize="14" iconColor="#10B981"/>
                      <Label fx:id="aiInsightAction" text="Recommendations are informational and do not change detection or policy." styleClass="breakdown-sub" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                  </VBox>

                  <!-- How AI Detects Threats (4 mini step cards in a row) -->
                  <VBox styleClass="stitch-card" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <FontIcon iconLiteral="fth-git-branch" iconSize="16" iconColor="#2563EB"/>
                      <Label text="How AI Detects Threats" styleClass="wd-section-title"/>
                    </HBox>

                    <GridPane hgap="8">
                      <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                      </columnConstraints>

                      <VBox GridPane.columnIndex="0" styleClass="detection-step-card">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                          <StackPane styleClass="step-number-circle">
                            <Label text="1" styleClass="step-number-text"/>
                          </StackPane>
                          <Region HBox.hgrow="ALWAYS"/>
                          <FontIcon iconLiteral="fth-file-text" iconSize="12" iconColor="#64748B"/>
                        </HBox>
                        <Label text="URL Feature Extraction" styleClass="wd-step-title" wrapText="true"/>
                        <Label text="Lexical &amp; domain attributes" styleClass="breakdown-sub" style="-fx-font-size: 9px;" wrapText="true"/>
                      </VBox>

                      <VBox GridPane.columnIndex="1" styleClass="detection-step-card">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                          <StackPane styleClass="step-number-circle">
                            <Label text="2" styleClass="step-number-text"/>
                          </StackPane>
                          <Region HBox.hgrow="ALWAYS"/>
                          <FontIcon iconLiteral="fth-cpu" iconSize="12" iconColor="#64748B"/>
                        </HBox>
                        <Label text="Machine Learning Prediction" styleClass="wd-step-title" wrapText="true"/>
                        <Label text="Ensemble classifier scoring" styleClass="breakdown-sub" style="-fx-font-size: 9px;" wrapText="true"/>
                      </VBox>

                      <VBox GridPane.columnIndex="2" styleClass="detection-step-card">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                          <StackPane styleClass="step-number-circle">
                            <Label text="3" styleClass="step-number-text"/>
                          </StackPane>
                          <Region HBox.hgrow="ALWAYS"/>
                          <FontIcon iconLiteral="fth-pie-chart" iconSize="12" iconColor="#64748B"/>
                        </HBox>
                        <Label text="Risk Score Evaluation" styleClass="wd-step-title" wrapText="true"/>
                        <Label text="Heuristic &amp; reputation weighting" styleClass="breakdown-sub" style="-fx-font-size: 9px;" wrapText="true"/>
                      </VBox>

                      <VBox GridPane.columnIndex="3" styleClass="detection-step-card">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                          <StackPane styleClass="step-number-circle">
                            <Label text="4" styleClass="step-number-text"/>
                          </StackPane>
                          <Region HBox.hgrow="ALWAYS"/>
                          <FontIcon iconLiteral="fth-check-circle" iconSize="12" iconColor="#64748B"/>
                        </HBox>
                        <Label text="Access Policy Decision" styleClass="wd-step-title" wrapText="true"/>
                        <Label text="ALLOW / WARN / BLOCK policy outcomes" styleClass="breakdown-sub" style="-fx-font-size: 9px;" wrapText="true"/>
                      </VBox>
                    </GridPane>
                  </VBox>
                </VBox>
              </GridPane>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 8. SETTINGS (EXACT STITCH SCREEN)                            -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="settingsPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <fx:include fx:id="settingsView" source="settings-view.fxml"/>
          </ScrollPane>
          <!-- 9. SECURE ACCESS                                             -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="secureAccessPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll, wd-pg-secure">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <VBox spacing="3">
                <Label text="Secure Access" styleClass="page-header-title"/>
                <Label text="Zero-trust perimeter controls, whitelist management, and corporate access policies." styleClass="page-header-subtitle"/>
              </VBox>

              <VBox styleClass="stitch-card" spacing="16">
                <HBox alignment="CENTER_LEFT">
                  <Label text="Domain Whitelist &amp; Exceptions" styleClass="panel-title" style="-fx-font-size: 15px; -fx-font-weight: 700;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="Exact-host exceptions skip URL model inference. Reputation, hostname, redirect, and browser-page signals stay active." styleClass="wd-exception-desc" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                  <TextField fx:id="domainExceptionInput" promptText="example.com" HBox.hgrow="ALWAYS" onAction="#addException"/>
                  <Button text="Add domain" onAction="#addException" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary"/>
                </HBox>

                <VBox fx:id="secureAccessContainer" spacing="12">
                  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="wd-exception-row">
                    <StackPane styleClass="metric-icon-circle, icon-emerald-bg" minWidth="36" minHeight="36" prefWidth="36" prefHeight="36">
                      <FontIcon fx:id="exceptionGlobe1" iconLiteral="fth-globe" iconSize="16" iconColor="#10B981"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                      <Label text="*.google.com" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>
                      <Label text="Internal allowlist â€¢ Zero inspection delay" styleClass="wd-exception-desc"/>
                    </VBox>
                    <Label text="ACTIVE" styleClass="pill-badge, badge-safe" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 3px 10px;"/>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="wd-exception-row">
                    <StackPane styleClass="metric-icon-circle, icon-blue-bg" minWidth="36" minHeight="36" prefWidth="36" prefHeight="36">
                      <FontIcon fx:id="exceptionGlobe2" iconLiteral="fth-globe" iconSize="16" iconColor="#2563EB"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                      <Label text="*.microsoft.com" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>
                      <Label text="Corporate identity provider exception" styleClass="wd-exception-desc"/>
                    </VBox>
                    <Label text="ACTIVE" styleClass="pill-badge, badge-safe" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 3px 10px;"/>
                  </HBox>
                </VBox>
              </VBox>
            </VBox>
          </ScrollPane>

        </StackPane>
      </VBox>
    </center>
  </BorderPane>

  <!-- Global Toast -->
  <Label fx:id="toast" text="Notification" visible="false" styleClass="toast-badge" StackPane.alignment="BOTTOM_CENTER">
    <StackPane.margin>
      <Insets bottom="24"/>
    </StackPane.margin>
  </Label>
</StackPane>
