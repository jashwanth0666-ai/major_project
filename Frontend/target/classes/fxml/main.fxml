                  <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="13" iconColor="#2563EB"/></graphic>
                </Button>
              </HBox>

              <VBox spacing="3">
                <Label text="Analyzing Website" styleClass="page-header-title"/>
