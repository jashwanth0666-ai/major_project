                </HBox>
              </HBox>

              <!-- Top Card: AI Protection Summary -->
              <VBox styleClass="stitch-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <StackPane styleClass="metric-icon-circle, icon-blue-bg" prefWidth="28" prefHeight="28">
                    <FontIcon iconLiteral="fth-cpu" iconSize="14" iconColor="#2563EB"/>
                  </StackPane>
                  <Label text="AI Protection Summary" styleClass="wd-section-title"/>
