                      <FontIcon fx:id="insightIcon0" iconLiteral="fth-check-circle" iconSize="14" iconColor="#10B981"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="6">
                      <Label fx:id="insightCount0" text="N/A" styleClass="metric-value"/>
                      <Label fx:id="insightTrend0" text="Unavailable" styleClass="metric-trend-up"/>
                    </HBox>
                    <Label text="Mean model score where output is available in the selected window" styleClass="breakdown-sub" style="-fx-font-size: 10px;" wrapText="true"/>
                    <Region styleClass="wd-ln, wd-ln-green"/>
                  </VBox>

                  <!-- Threats Identified -->
                  <VBox fx:id="insightCard1" GridPane.columnIndex="1" styleClass="metric-card, wd-insight-card">
                    <HBox alignment="CENTER_LEFT">
                      <Label text="PHISHING PREDICTIONS" styleClass="info-label" style="-fx-font-size: 10px;"/>
                      <Region HBox.hgrow="ALWAYS"/>
                      <FontIcon fx:id="insightIcon1" iconLiteral="fth-shield" iconSize="14" iconColor="#EF4444"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="6">
                      <Label fx:id="insightCount1" text="0" styleClass="metric-value"/>
                      <Label fx:id="insightTrend1" text="Unavailable" styleClass="metric-trend-red"/>
                    </HBox>
                    <Label text="Full-window URL predictions labeled phishing" styleClass="breakdown-sub" style="-fx-font-size: 10px;" wrapText="true"/>
                    <Region styleClass="wd-ln, wd-ln-red"/>
                  </VBox>

                  <!-- False Positive Rate -->
                  <VBox fx:id="insightCard2" GridPane.columnIndex="2" styleClass="metric-card, wd-insight-card">
                    <HBox alignment="CENTER_LEFT">
                      <Label text="USER FEEDBACK" styleClass="info-label" style="-fx-font-size: 10px;"/>
                      <Region HBox.hgrow="ALWAYS"/>
                      <FontIcon fx:id="insightIcon2" iconLiteral="fth-sliders" iconSize="14" iconColor="#10B981"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="6">
                      <Label fx:id="insightCount2" text="0" styleClass="metric-value"/>
                      <Label fx:id="insightTrend2" text="Stored user labels" styleClass="metric-trend-up"/>
                    </HBox>
                    <Label text="Human-submitted labels linked to assessments" styleClass="breakdown-sub" style="-fx-font-size: 10px;" wrapText="true"/>
                    <Region styleClass="wd-ln, wd-ln-green"/>
                  </VBox>

                  <!-- URLs Analyzed -->
                  <VBox fx:id="insightCard3" GridPane.columnIndex="3" styleClass="metric-card, wd-insight-card">
                    <HBox alignment="CENTER_LEFT">
                      <Label text="URLS ANALYZED" styleClass="info-label" style="-fx-font-size: 10px;"/>
                      <Region HBox.hgrow="ALWAYS"/>
                      <FontIcon fx:id="insightIcon3" iconLiteral="fth-target" iconSize="14" iconColor="#3B6DF0"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="6">
                      <Label fx:id="insightCount3" text="0" styleClass="metric-value"/>
                      <Label fx:id="insightTrend3" text="Backend count" styleClass="metric-trend-up" style="-fx-text-fill: #3B6DF0;"/>
                    </HBox>
                    <Label text="All stored URL assessments in the selected period" styleClass="breakdown-sub" style="-fx-font-size: 10px;" wrapText="true"/>
                    <Region styleClass="wd-ln, wd-ln-blue"/>
                  </VBox>
                </GridPane>
              </VBox>

              <!-- Bottom 2-Column Section -->
              <GridPane hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="50"/>
                  <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Left: Threat Pattern Analysis -->
                <VBox GridPane.columnIndex="0" styleClass="stitch-card" spacing="14">
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fth-bar-chart-2" iconSize="16" iconColor="#2563EB"/>
                    <Label text="Threat Pattern Analysis" styleClass="wd-section-title"/>
                  </HBox>
                    <Label text="Behavioral heuristics and recorded policy outcomes; Windows access enforcement is not provided." styleClass="page-header-subtitle" wrapText="true"/>

                  <VBox spacing="14" style="-fx-padding: 8px 0 12px 0;">
                    <!-- Suspicious domains -->
                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT">
                        <Label text="Brand look-alike signals" styleClass="feature-key" style="-fx-font-weight: 600;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="insightPattern0" text="0" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                      </HBox>
                      <ProgressBar fx:id="insightPatternBar0" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-amber"/>
                    </VBox>

                    <!-- Lookalike domains -->
                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT">
                        <Label text="IDN and confusable hosts" styleClass="feature-key" style="-fx-font-weight: 600;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="insightPattern1" text="0" styleClass="metric-label" style="-fx-font-weight: 600;"/>
