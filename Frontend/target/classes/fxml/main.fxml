                <HBox spacing="10" alignment="CENTER">
                  <ComboBox fx:id="activityTimeFilter" promptText="Last 7 days" styleClass="stitch-combo-box"/>
                  <Button text="+ Export" onAction="#exportReport" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary"/>
                </HBox>
              </HBox>

              <!-- 4 Metric Cards -->
              <GridPane hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <!-- Total Events -->
                <VBox fx:id="activityCard0" GridPane.columnIndex="0" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="activityTile0" styleClass="metric-icon-circle, icon-blue-bg">
