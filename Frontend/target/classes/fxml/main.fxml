                <!-- URLs Scanned -->
                <VBox fx:id="activityCard1" GridPane.columnIndex="1" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="activityTile1" styleClass="metric-icon-circle, icon-blue-bg">
                      <FontIcon fx:id="activityIcon1" iconLiteral="fth-globe" iconSize="18" iconColor="#3B6DF0"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="activityCount1" text="0" styleClass="metric-value"/>
                  <Label text="URLs Scanned" styleClass="metric-label"/>
                  <Label text="Recent URL analyses" styleClass="breakdown-sub"/>
                  <Region styleClass="wd-ln, wd-ln-blue"/>
                </VBox>

                <!-- Recorded policy BLOCK decisions; no OS enforcement is provided. -->
                <VBox fx:id="activityCard2" GridPane.columnIndex="2" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="activityTile2" styleClass="metric-icon-circle, icon-red-bg">
                      <FontIcon fx:id="activityIcon2" iconLiteral="fth-alert-triangle" iconSize="18" iconColor="#EF4444"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="activityCount2" text="0" styleClass="metric-value"/>
                  <Label text="BLOCK Policy Decisions" styleClass="metric-label"/>
                  <Label text="Recorded outcome; OS enforcement is unavailable" styleClass="breakdown-sub" wrapText="true"/>
                  <Region styleClass="wd-ln, wd-ln-red"/>
                </VBox>

                <!-- Access Decisions -->
                <VBox fx:id="activityCard3" GridPane.columnIndex="3" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="activityTile3" styleClass="metric-icon-circle, icon-green-bg">
                      <FontIcon fx:id="activityIcon3" iconLiteral="fth-check" iconSize="18" iconColor="#10B981"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="activityCount3" text="0" styleClass="metric-value"/>
                  <Label text="Access Decisions" styleClass="metric-label"/>
                  <Label text="Recorded decisions" styleClass="breakdown-sub"/>
                  <Region styleClass="wd-ln, wd-ln-green"/>
                </VBox>
              </GridPane>

              <!-- Security Activity Log Card -->
              <VBox styleClass="stitch-card" spacing="16">
                <!-- Log Card Filter Controls -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Label text="Security Activity Log" styleClass="panel-title" style="-fx-font-size: 15px; -fx-font-weight: 700;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="stitch-text-field" prefWidth="220" style="-fx-padding: 4px 10px;">
                    <FontIcon iconLiteral="fth-search" iconSize="14" iconColor="#94A3B8"/>
                    <TextField fx:id="activitySearchInput" promptText="Search activity..." onKeyReleased="#filterActivityLog" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12px;"/>
                  </HBox>
                  <ComboBox fx:id="activityEventFilter" promptText="All Events" styleClass="stitch-combo-box"/>
                  <ComboBox fx:id="activityStatusFilter" promptText="All Status" styleClass="stitch-combo-box"/>
                </HBox>

                <!-- Table Header -->
                <HBox styleClass="table-header-row" alignment="CENTER_LEFT">
                  <Label text="TIME" prefWidth="90" styleClass="table-header-label"/>
                  <Label text="EVENT" prefWidth="160" styleClass="table-header-label"/>
                  <Label text="URL / DESCRIPTION" prefWidth="300" styleClass="table-header-label"/>
                  <Label text="RISK LEVEL" prefWidth="110" styleClass="table-header-label"/>
                  <Label text="DECISION" prefWidth="90" styleClass="table-header-label"/>
                  <Label text="STATUS" prefWidth="100" styleClass="table-header-label"/>
                </HBox>

                <!-- Activity Log Rows Container -->
                <VBox fx:id="activityTableContainer" spacing="2"/>

                <!-- Pagination Footer -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12px 0 0 0;">
                  <Label fx:id="activityPaginationLabel" text="Waiting for backend event history" styleClass="breakdown-sub"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="activityPreviousBtn" text="&lt; Previous" onAction="#previousActivityPage" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary, wd-dbtn" style="-fx-font-size: 11px; -fx-padding: 5px 10px;"/>
                    <Label fx:id="activityPageLabel" text="Page 1 of 1" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                    <Button fx:id="activityNextBtn" text="Next &gt;" onAction="#nextActivityPage" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary, wd-dbtn" style="-fx-font-size: 11px; -fx-padding: 5px 10px;"/>
                  </HBox>
                </HBox>
              </VBox>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 7. AI INSIGHTS (EXACT STITCH SCREEN)                         -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="insightsPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll, wd-pg-ai">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <!-- Header -->
              <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                  <Label text="AI Insights" styleClass="page-header-title"/>
