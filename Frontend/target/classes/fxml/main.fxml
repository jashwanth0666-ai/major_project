                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER">
                  <ComboBox fx:id="threatTimeFilter" promptText="Last 7 days" styleClass="stitch-combo-box"/>
                  <Button text="+ Export Report" onAction="#exportReport" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary"/>
