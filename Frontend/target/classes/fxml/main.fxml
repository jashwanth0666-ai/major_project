<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aiwatchdog.controller.MainController" styleClass="app-root" stylesheets="@../css/wd-buttons-fx.css">

  <!-- ================================================================== -->
  <!-- STARTING / SPLASH PAGE (5s AUTO-TRANSITION)                        -->
  <!-- ================================================================== -->
  <VBox fx:id="welcomePage" alignment="CENTER" styleClass="welcome-page-new">
    <VBox fx:id="splashContentBox" alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS">
      <StackPane fx:id="splashLogoContainer" alignment="CENTER" prefWidth="300" prefHeight="300">
        <Circle fx:id="splashGlowCircle" radius="125" styleClass="splash-glow-circle"/>
        <ImageView fx:id="logoImage" fitWidth="280" preserveRatio="true">
          <image>
            <Image url="@../images/logo.png"/>
          </image>
        </ImageView>
      </StackPane>
      <VBox alignment="CENTER" spacing="6">
        <Label fx:id="splashTitleLabel" text="AI WATCHDOG" styleClass="welcome-title-new"/>
        <Label fx:id="splashSubtitleLabel" text="SECURITY IN EVERY CLICK" styleClass="welcome-subtitle-new"/>
      </VBox>
      <StackPane alignment="CENTER" maxWidth="240" prefHeight="10">
        <ProgressBar fx:id="splashProgressBar" progress="0.0" prefWidth="240" maxHeight="3.5" styleClass="splash-progress-bar"/>
      </StackPane>
    </VBox>
  </VBox>

  <!-- ================================================================== -->
  <!-- MAIN APPLICATION SHELL                                             -->
  <!-- ================================================================== -->
  <BorderPane fx:id="appShell" styleClass="shell" visible="false" managed="false">
    <!-- ================================================================== -->
    <!-- LEFT SIDEBAR                                                       -->
    <!-- ================================================================== -->
    <left>
      <VBox fx:id="sidebar" styleClass="sidebar" spacing="12">
        <!-- Logo & Branding -->
        <HBox fx:id="brandContainer" alignment="CENTER_LEFT" spacing="12" styleClass="brand-container">
          <ImageView fitWidth="52" fitHeight="52" preserveRatio="true" smooth="true">
            <image>
              <Image url="@../images/watchdog-logo.png" requestedWidth="104" requestedHeight="104" preserveRatio="true" smooth="true"/>
            </image>
          </ImageView>
          <VBox spacing="1">
            <Label text="AI WatchDog" styleClass="brand-title"/>
            <Label text="Phishing Detection Platform" styleClass="brand-subtitle"/>
          </VBox>
        </HBox>

        <!-- Navigation Menu -->
        <ScrollPane fx:id="sidebarNavScroll" fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="wd-sidebar-scroll, wd-scroll">
          <VBox fx:id="navMenuBox" spacing="4" styleClass="nav-menu">
            <Button fx:id="navDashboardBtn" text="Dashboard" onAction="#navigateDashboard" styleClass="nav-btn, nav-btn-active, wd-nav, wd-on, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-grid" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navScannerBtn" text="URL Scanner" onAction="#navigateScanner" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-search" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navFileShieldBtn" text="File Shield Scanner" onAction="#navigateFileShield" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-hard-drive" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navSecureAccessBtn" text="Secure Access" onAction="#navigateSecureAccess" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-shield" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navThreatCenterBtn" text="Threat Center" onAction="#navigateThreatCenter" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-alert-triangle" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navActivityBtn" text="Activity" onAction="#navigateActivity" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-user" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navInsightsBtn" text="AI Insights" onAction="#navigateInsights" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-zap" iconSize="17"/></graphic>
            </Button>
            <Button fx:id="navSettingsBtn" text="Settings" onAction="#navigateSettings" styleClass="nav-btn, wd-nav, wd-dbtn">
              <graphic><FontIcon iconLiteral="fth-settings" iconSize="17"/></graphic>
            </Button>
          </VBox>
        </ScrollPane>

        <!-- Bottom Protection Active Status (Exact Stitch layout) -->
        <VBox fx:id="sidebarBottomBox" spacing="6" alignment="CENTER">
          <HBox alignment="CENTER_LEFT" spacing="10" styleClass="protection-status-card" maxWidth="Infinity">
            <StackPane prefWidth="26" prefHeight="26" minWidth="26" minHeight="26" style="-fx-background-color: #10B981; -fx-background-radius: 50%; -fx-alignment: center;">
              <FontIcon iconLiteral="fth-check" iconSize="13" iconColor="#FFFFFF"/>
            </StackPane>
            <VBox spacing="1" HBox.hgrow="ALWAYS">
              <Label fx:id="sidebarProtectionTitle" text="Checking services…" styleClass="protection-status-title"/>
              <Label fx:id="sidebarProtectionDescription" text="Waiting for backend health and monitor state" styleClass="protection-status-desc" wrapText="true"/>
            </VBox>
          </HBox>
          <Label text="v1.0.0" styleClass="version-label" style="-fx-font-size: 10px; -fx-alignment: center;"/>
        </VBox>
      </VBox>
    </left>

    <!-- ================================================================== -->
    <!-- MAIN CONTENT AREA                                                  -->
    <!-- ================================================================== -->
    <center>
      <VBox spacing="0">
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
          <!-- Hamburger Toggle Button -->
          <Button fx:id="hamburgerBtn" onAction="#toggleSidebar" styleClass="wd-burger, wd-btn, wd-btn--icon, wd-icon, wd-btn--static, wd-dbtn" minWidth="38" minHeight="38" prefWidth="38" prefHeight="38" maxWidth="38" maxHeight="38">
            <graphic>
              <StackPane alignment="CENTER" prefWidth="18" prefHeight="14" maxWidth="18" maxHeight="14">
                <Region fx:id="hamburgerBarTop" styleClass="wd-burger-bar" translateY="-5" prefWidth="18" prefHeight="2" maxWidth="18" maxHeight="2"/>
                <Region fx:id="hamburgerBarMid" styleClass="wd-burger-bar" prefWidth="18" prefHeight="2" maxWidth="18" maxHeight="2"/>
                <Region fx:id="hamburgerBarBot" styleClass="wd-burger-bar" translateY="5" prefWidth="18" prefHeight="2" maxWidth="18" maxHeight="2"/>
              </StackPane>
            </graphic>
          </Button>

          <!-- Search Field -->
          <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-search-box">
            <FontIcon iconLiteral="fth-search" iconSize="15" iconColor="#94A3B8"/>
            <TextField fx:id="topSearchInput" promptText="Search or analyze a URL..." onAction="#onTopSearchSubmit" styleClass="top-search-input" HBox.hgrow="ALWAYS"/>
          </HBox>

          <Region HBox.hgrow="ALWAYS"/>

          <!-- Notification Bell -->
          <StackPane styleClass="icon-btn-round, wd-btn--icon, wd-icon, wd-btn--round, wd-btn--bell, wd-btn--static, wd-dbtn, wd-dbtn--round">
            <FontIcon iconLiteral="fth-bell" iconSize="16" iconColor="#64748B"/>
            <Circle radius="4" fill="#EF4444" translateX="6" translateY="-6"/>
          </StackPane>
        </HBox>

        <!-- Page Stack -->
        <StackPane fx:id="pageStack" VBox.vgrow="ALWAYS">

          <!-- ============================================================ -->
          <!-- 1. DASHBOARD / SECURITY OVERVIEW (STITCH SCREEN 1)           -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="dashboardPage" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <!-- Header -->
              <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                  <Label text="Security Overview" styleClass="page-header-title"/>
                  <Label text="Monitor, analyze and stay protected from online threats." styleClass="page-header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="dashDateLabel" text="Tue, 10 Sep 2026 â€¢ 11:42 AM" styleClass="header-timestamp"/>
              </HBox>

              <!-- 4 Metric Cards (Upgraded Target Design) -->
              <GridPane styleClass="wd-stats" hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <!-- URLs Scanned -->
                <VBox fx:id="dashCardScanned" GridPane.columnIndex="0" styleClass="wd-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="dashScannedTile" styleClass="wd-ic, wd-ic-blue">
                      <FontIcon fx:id="dashScannedIcon" iconLiteral="fth-globe" iconSize="20" iconColor="#3B6DF0"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dashScannedTrend" visible="false" managed="false"/>
                  </HBox>
                  <Label text="URLs Scanned" styleClass="wd-lb" style="-fx-padding: 16px 0 0 0;"/>
                  <Label fx:id="dashScannedCount" text="0" styleClass="wd-nm"/>
                  <Label text="Backend total" styleClass="wd-sb" style="-fx-padding: 6px 0 0 0;"/>
                  <Region fx:id="dashScannedLine" styleClass="wd-ln, wd-ln-blue"/>
                </VBox>

                <!-- Recorded policy BLOCK decisions; no OS enforcement is provided. -->
                <VBox fx:id="dashCardBlocked" GridPane.columnIndex="1" styleClass="wd-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="dashBlockedTile" styleClass="wd-ic, wd-ic-red">
                      <FontIcon fx:id="dashBlockedIcon" iconLiteral="fth-alert-triangle" iconSize="20" iconColor="#EF4444"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dashBlockedTrend" visible="false" managed="false"/>
                  </HBox>
                  <Label text="BLOCK Policy Decisions" styleClass="wd-lb" style="-fx-padding: 16px 0 0 0;"/>
                  <Label fx:id="dashThreatsBlockedCount" text="0" styleClass="wd-nm"/>
                  <Label text="Backend total" styleClass="wd-sb" style="-fx-padding: 6px 0 0 0;"/>
                  <Region fx:id="dashBlockedLine" styleClass="wd-ln, wd-ln-red"/>
                </VBox>

                <!-- In Review -->
                <VBox fx:id="dashCardReview" GridPane.columnIndex="2" styleClass="wd-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="dashReviewTile" styleClass="wd-ic, wd-ic-amber">
                      <FontIcon fx:id="dashReviewIcon" iconLiteral="fth-target" iconSize="20" iconColor="#F59E0B"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dashReviewTrend" visible="false" managed="false"/>
                  </HBox>
                  <Label text="In Review" styleClass="wd-lb" style="-fx-padding: 16px 0 0 0;"/>
                  <Label fx:id="dashInReviewCount" text="0" styleClass="wd-nm"/>
                  <Label text="Backend total" styleClass="wd-sb" style="-fx-padding: 6px 0 0 0;"/>
                  <Region fx:id="dashReviewLine" styleClass="wd-ln, wd-ln-amber"/>
                </VBox>

                <!-- Allowed URLs -->
                <VBox fx:id="dashCardAllowed" GridPane.columnIndex="3" styleClass="wd-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="dashAllowedTile" styleClass="wd-ic, wd-ic-green">
                      <FontIcon fx:id="dashAllowedIcon" iconLiteral="fth-check" iconSize="20" iconColor="#10B981"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dashAllowedTrend" visible="false" managed="false"/>
                  </HBox>
                  <Label text="Allowed URLs" styleClass="wd-lb" style="-fx-padding: 16px 0 0 0;"/>
                  <Label fx:id="dashAllowedCount" text="0" styleClass="wd-nm"/>
                  <Label text="Backend total" styleClass="wd-sb" style="-fx-padding: 6px 0 0 0;"/>
                  <Region fx:id="dashAllowedLine" styleClass="wd-ln, wd-ln-green"/>
                </VBox>
              </GridPane>

              <VBox styleClass="stitch-card" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Unified Assessment Overview" styleClass="panel-title"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <ProgressIndicator fx:id="dashAssessmentLoading" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
                  <Label fx:id="dashAssessmentState" text="Loading assessment metrics…" styleClass="breakdown-sub"/>
                </HBox>
                <HBox spacing="24" alignment="CENTER_LEFT">
                  <VBox spacing="3"><Label fx:id="dashAssessmentTotal" text="N/A" styleClass="metric-value"/><Label text="Recorded assessments" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashAssessmentUrls" text="N/A" styleClass="metric-value"/><Label text="URL assessments" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashAssessmentFiles" text="N/A" styleClass="metric-value"/><Label text="File assessments" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashAssessmentPartial" text="N/A" styleClass="metric-value"/><Label text="Partial results" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashKnownMalicious" text="N/A" styleClass="metric-value"/><Label text="Known malicious reputation" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashUnknownReputation" text="N/A" styleClass="metric-value"/><Label text="Unknown reputation" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashKnownClean" text="N/A" styleClass="metric-value"/><Label text="Known clean reputation" styleClass="metric-label"/></VBox>
                  <VBox spacing="3"><Label fx:id="dashLookupError" text="N/A" styleClass="metric-value"/><Label text="Reputation lookup errors" styleClass="metric-label"/></VBox>
                </HBox>
                <HBox spacing="24" alignment="CENTER_LEFT">
                  <Label text="Assessment policy verdicts:" styleClass="metric-label"/>
                  <Label text="ALLOW" styleClass="breakdown-sub"/><Label fx:id="dashAssessmentAllow" text="N/A" styleClass="metric-value"/>
                  <Label text="REVIEW" styleClass="breakdown-sub"/><Label fx:id="dashAssessmentReview" text="N/A" styleClass="metric-value"/>
                  <Label text="WARN" styleClass="breakdown-sub"/><Label fx:id="dashAssessmentWarn" text="N/A" styleClass="metric-value"/>
                  <Label text="BLOCK" styleClass="breakdown-sub"/><Label fx:id="dashAssessmentBlock" text="N/A" styleClass="metric-value"/>
                </HBox>
              </VBox>

              <!-- Current Risk Status Large Card (Target Lock Radar & Breakdown) -->
              <VBox styleClass="wd-risk" spacing="18">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                  <Label text="Current Risk Status" styleClass="panel-title" style="-fx-font-size: 17px; -fx-font-weight: 700;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Label fx:id="dashOperationalBadge" text="â— All Systems Operational" styleClass="wd-ok"/>
                </HBox>

                <!-- 3-Column Body -->
                <HBox spacing="0" alignment="CENTER_LEFT">
                  <!-- Col 1: Radar (230px) -->
                  <VBox alignment="CENTER" minWidth="230" prefWidth="230" maxWidth="230" spacing="10">
                    <StackPane fx:id="dashGaugeContainer" styleClass="wd-ring" minWidth="210" minHeight="210" prefWidth="210" prefHeight="210" maxWidth="210" maxHeight="210" alignment="CENTER">
                      <!-- Retain legacy node references for backward compatibility -->
                      <Group visible="false" managed="false">
                        <Circle radius="72" styleClass="gauge-bg-circle"/>
                        <Arc fx:id="dashScoreArc" radiusX="72" radiusY="72" startAngle="90" length="-43.2" type="OPEN" styleClass="gauge-arc-fill" visible="false" managed="false"/>
                      </Group>
                      <!-- Centered score number -->
                      <Label fx:id="dashScoreNumber" text="0" styleClass="wd-radar-num"/>
                    </StackPane>
                    <Label fx:id="dashScorePill" text="RISK SCORE Â· /100" styleClass="wd-rchip, wd-rchip-low"/>
                  </VBox>

                  <!-- Col 2: Center Risk Status Details -->
                  <VBox styleClass="wd-mid" spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <Label fx:id="dashStatusNormalLabel" text="â— STATUS NORMAL" styleClass="wd-status-low"/>
                    <Label fx:id="dashRiskLevelTitle" text="Low Risk" styleClass="hero-title" style="-fx-font-size: 34px; -fx-font-weight: 600;"/>
                    <Label fx:id="dashRiskDescription" text="Risk score from the latest URL assessment returned by Spring Boot." wrapText="true" styleClass="page-header-subtitle" maxWidth="430" style="-fx-padding: 0 0 10px 0;"/>
                    <HBox alignment="CENTER_LEFT">
                      <HBox fx:id="dashLiveShieldBox" alignment="CENTER_LEFT" spacing="8" styleClass="wd-live">
                        <FontIcon fx:id="dashLiveShieldIcon" iconLiteral="fth-shield" iconSize="18" iconColor="#10B981"/>
                        <Label fx:id="dashLiveShieldText" text="Live Shield Paused" styleClass="wd-live-text"/>
                      </HBox>
                    </HBox>
                    <Button fx:id="dashLiveShieldToggle" text="Start monitoring" onAction="#toggleLocalMonitoring" styleClass="stitch-btn-secondary, wd-btn, wd-tonal, wd-btn--tonal"/>
                    <Label fx:id="dashMonitorStatus" text="Monitoring is off. Start it here or configure watched folders in Settings." styleClass="breakdown-sub" wrapText="true"/>
                    <Button text="Manage monitored folders" onAction="#navigateLocalMonitoringSettings" styleClass="stitch-btn-secondary, wd-btn, wd-tonal, wd-btn--tonal"/>
                  </VBox>

                  <!-- Col 3: Right Threat Breakdown (340px) -->
                  <VBox styleClass="wd-brk" minWidth="340" prefWidth="340" maxWidth="340" spacing="13">
                    <HBox alignment="CENTER_LEFT">
                      <Label text="THREAT BREAKDOWN" styleClass="breakdown-title" style="-fx-font-size: 13.5px; -fx-font-weight: 700;"/>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label text="Last 24 Hours" styleClass="breakdown-sub" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                    </HBox>

                    <!-- Safe -->
                    <VBox spacing="6">
                      <HBox alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                          <Circle radius="4.5" fill="#10B981"/>
                          <Label text="Safe" styleClass="metric-label" style="-fx-font-size: 14px;"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dashSafePercent" text="—" styleClass="metric-label" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                      </HBox>
                      <ProgressBar fx:id="dashSafeProgress" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-green"/>
                    </VBox>

                    <!-- Suspicious -->
                    <VBox spacing="6">
                      <HBox alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                          <Circle radius="4.5" fill="#3B6DF0"/>
                          <Label text="Suspicious" styleClass="metric-label" style="-fx-font-size: 14px;"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dashSuspiciousPercent" text="—" styleClass="metric-label" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                      </HBox>
                      <ProgressBar fx:id="dashSuspiciousProgress" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-blue"/>
                    </VBox>

                    <!-- Potential Risk -->
                    <VBox spacing="6">
                      <HBox alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                          <Circle radius="4.5" fill="#F59E0B"/>
                          <Label text="Potential Risk" styleClass="metric-label" style="-fx-font-size: 14px;"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dashPotentialPercent" text="—" styleClass="metric-label" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                      </HBox>
                      <ProgressBar fx:id="dashPotentialProgress" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-amber"/>
                    </VBox>

                    <!-- High Risk -->
                    <VBox spacing="6">
                      <HBox alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                          <Circle radius="4.5" fill="#EF4444"/>
                          <Label text="High Risk" styleClass="metric-label" style="-fx-font-size: 14px;"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dashHighRiskPercent" text="—" styleClass="metric-label" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                      </HBox>
                      <ProgressBar fx:id="dashHighRiskProgress" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-red"/>
                    </VBox>
                  </VBox>
                </HBox>
              </VBox>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- FILE SHIELD SCANNER                                         -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="fileShieldPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <content>
              <fx:include fx:id="fileShieldView" source="file-shield-view.fxml"/>
            </content>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 2. URL SCANNER - INPUT SCREEN                                -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="scannerInputPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <VBox spacing="3">
                <Label text="URL Scanner" styleClass="page-header-title"/>
                <Label text="Submit any target website or link for neural threat intelligence analysis." styleClass="page-header-subtitle"/>
              </VBox>

              <VBox styleClass="stitch-card" spacing="18">
                <Label text="Target URL Analysis" styleClass="wd-section-title"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                  <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stitch-text-field" HBox.hgrow="ALWAYS" style="-fx-padding: 8px 14px;">
                    <FontIcon iconLiteral="fth-search" iconSize="16" iconColor="#94A3B8"/>
                    <TextField fx:id="scannerUrlInput" promptText="Enter URL to inspect (e.g. https://www.google.com)" HBox.hgrow="ALWAYS" onAction="#analyzeManual" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                  </HBox>
                  <Button fx:id="analyzeBtn" text="Analyze Website" onAction="#analyzeManual" styleClass="stitch-btn-analyze-green, wd-btn, wd-primary, wd-btn--primary">
                    <graphic><FontIcon iconLiteral="fth-shield" iconSize="16" iconColor="#FFFFFF"/></graphic>
                  </Button>
                </HBox>

                <Separator/>

                <VBox spacing="10">
                  <Label text="Quick Test Presets" styleClass="table-header-label"/>
                  <HBox spacing="12">
                    <Button text="Clean Target (Google)" onAction="#simulateSafe" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary, wd-dbtn">
                      <graphic><FontIcon iconLiteral="fth-check-circle" iconSize="14" iconColor="#10B981"/></graphic>
                    </Button>
                    <Button text="Suspicious Target (PayPal Verify)" onAction="#simulateSuspicious" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary, wd-dbtn">
                      <graphic><FontIcon iconLiteral="fth-alert-triangle" iconSize="14" iconColor="#F59E0B"/></graphic>
                    </Button>
                    <Button text="Malicious Exploit (Phishing)" onAction="#simulatePhishing" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary, wd-dbtn">
                      <graphic><FontIcon iconLiteral="fth-alert-octagon" iconSize="14" iconColor="#EF4444"/></graphic>
                    </Button>
                  </HBox>
                </VBox>
              </VBox>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 3. ANALYZING WEBSITE SCREEN (STITCH SCREEN 2)                -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="analyzingPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
