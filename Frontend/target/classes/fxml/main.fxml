<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aiwatchdog.controller.MainController" styleClass="app-root">
  <left>
    <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="232" minWidth="216" spacing="8">
      <HBox alignment="CENTER_LEFT" spacing="11" styleClass="brand-block">
        <StackPane styleClass="brand-mark"><FontIcon iconLiteral="fth-shield" iconSize="19" styleClass="brand-icon"/></StackPane>
        <VBox spacing="1"><Label text="AI WatchDog" styleClass="brand-name"/><Label text="LOCAL SECURITY" styleClass="brand-caption"/></VBox>
      </HBox>
      <Region prefHeight="18"/>
      <Label text="WORKSPACE" styleClass="nav-caption"/>
      <Button fx:id="navDashboardBtn" text="Dashboard" onAction="#navigateDashboard" styleClass="nav-button nav-active" accessibleText="Dashboard">
        <graphic><FontIcon iconLiteral="fth-grid" iconSize="16"/></graphic>
      </Button>
      <Button fx:id="navAnalyzeBtn" text="Analyze URL" onAction="#navigateAnalyze" styleClass="nav-button" accessibleText="Analyze URL">
        <graphic><FontIcon iconLiteral="fth-search" iconSize="16"/></graphic>
      </Button>
      <Button fx:id="navHistoryBtn" text="History" onAction="#navigateHistory" styleClass="nav-button" accessibleText="Security history">
        <graphic><FontIcon iconLiteral="fth-clock" iconSize="16"/></graphic>
      </Button>
      <Button fx:id="navMonitoringBtn" text="Monitoring" onAction="#navigateMonitoring" styleClass="nav-button" accessibleText="Monitoring status">
        <graphic><FontIcon iconLiteral="fth-activity" iconSize="16"/></graphic>
      </Button>
      <Region prefHeight="14"/>
      <Label text="PREFERENCES" styleClass="nav-caption"/>
      <Button fx:id="navSettingsBtn" text="Settings" onAction="#navigateSettings" styleClass="nav-button" accessibleText="Settings">
        <graphic><FontIcon iconLiteral="fth-settings" iconSize="16"/></graphic>
      </Button>
      <Region VBox.vgrow="ALWAYS"/>
      <VBox styleClass="sidebar-status" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="8"><Region fx:id="backendDot" styleClass="status-dot status-pending"/><Label text="SPRING BACKEND" styleClass="status-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="backendStatus" text="Checking" styleClass="status-value"/></HBox>
        <HBox alignment="CENTER_LEFT" spacing="8"><Region fx:id="mlDot" styleClass="status-dot status-pending"/><Label text="ML SERVICE" styleClass="status-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="mlStatus" text="Checking" styleClass="status-value"/></HBox>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="9" styleClass="profile-row">
        <StackPane styleClass="profile-mark"><FontIcon iconLiteral="fth-lock" iconSize="14"/></StackPane>
        <VBox spacing="2"><Label text="AI WatchDog" styleClass="profile-title"/><Label text="Local desktop app" styleClass="profile-subtitle"/></VBox>
      </HBox>
    </VBox>
  </left>
  <center>
    <BorderPane styleClass="workspace">
      <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <VBox spacing="2"><Label fx:id="pageTitle" text="Dashboard" styleClass="topbar-title"/><Label fx:id="pageSubtitle" text="Current service health and recent security events" styleClass="topbar-subtitle"/></VBox>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="connectionPill" text="CONNECTING" styleClass="connection-pill status-pending"/>
          <Button text="Refresh" onAction="#refreshData" styleClass="quiet-button" accessibleText="Refresh backend data"/>
        </HBox>
      </top>
      <center>
        <StackPane fx:id="pageStack" styleClass="page-stack">
          <ScrollPane fx:id="dashboardPage" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
              <VBox spacing="22" styleClass="page-content">
                <HBox alignment="CENTER_LEFT" spacing="16">
                  <VBox spacing="5"><Label text="Security overview" styleClass="page-heading"/><Label text="A live view of this device’s local security services and recorded activity." styleClass="body-secondary" wrapText="true"/></VBox>
                  <Region HBox.hgrow="ALWAYS"/><Button text="Analyze a URL" onAction="#navigateAnalyze" styleClass="primary-button"/></HBox>
                <HBox spacing="14" styleClass="status-banner" alignment="CENTER_LEFT">
                  <StackPane styleClass="banner-icon"><FontIcon iconLiteral="fth-shield" iconSize="22" styleClass="accent-icon"/></StackPane>
                  <VBox spacing="3" HBox.hgrow="ALWAYS"><Label fx:id="systemStateTitle" text="Connecting to local services" styleClass="banner-title"/><Label fx:id="systemStateDetail" text="Status updates from the Spring health endpoint." styleClass="body-secondary" wrapText="true"/></VBox>
                  <Label fx:id="monitoringSummary" text="Monitoring starting" styleClass="summary-chip"/>
                </HBox>
                <HBox spacing="12">
                  <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS" spacing="10"><Label text="URL ANALYSES" styleClass="metric-caption"/><Label fx:id="totalEventsValue" text="—" styleClass="metric-value"/><Label text="All recorded URL events" styleClass="metric-note"/></VBox>
                  <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS" spacing="10"><Label text="HIGH RISK" styleClass="metric-caption"/><Label fx:id="highRiskValue" text="—" styleClass="metric-value risk-value"/><Label text="URL events marked HIGH_RISK" styleClass="metric-note"/></VBox>
                  <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS" spacing="10"><Label text="BLOCK DECISIONS" styleClass="metric-caption"/><Label fx:id="blockedValue" text="—" styleClass="metric-value"/><Label text="URL events with BLOCK decision" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="Recent activity" styleClass="section-heading"/><Label text="Latest URL and monitor events available from the backend." styleClass="body-secondary"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="View history" onAction="#navigateHistory" styleClass="text-button"/></HBox>
                <StackPane styleClass="event-list-panel" minHeight="235" prefHeight="280" VBox.vgrow="ALWAYS">
                  <ListView fx:id="recentList" styleClass="event-list" accessibleText="Recent security events"/>
                  <VBox fx:id="recentEmptyState" visible="false" managed="false" alignment="CENTER" spacing="8" styleClass="empty-state"><FontIcon iconLiteral="fth-inbox" iconSize="24" styleClass="empty-icon"/><Label text="No security events yet" styleClass="empty-title"/><Label text="URL analyses and monitor events will appear here." styleClass="body-secondary"/></VBox>
                  <ProgressIndicator fx:id="dashboardLoading" visible="false" managed="false" maxWidth="30" maxHeight="30"/>
                </StackPane>
                <Label fx:id="dashboardMessage" text="" styleClass="inline-message" wrapText="true"/>
              </VBox>
            </content>
          </ScrollPane>

          <ScrollPane fx:id="analysisPage" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
              <VBox spacing="24" styleClass="page-content analysis-content">
                <VBox spacing="6"><Label text="Analyze a URL" styleClass="page-heading"/><Label text="Check a link with the configured AI WatchDog service before you open it." styleClass="body-secondary" wrapText="true"/></VBox>
                <VBox styleClass="analysis-panel" spacing="15">
                  <Label text="WEB ADDRESS" styleClass="metric-caption"/>
                  <HBox spacing="10" alignment="CENTER_LEFT" styleClass="url-entry">
                    <FontIcon iconLiteral="fth-link" iconSize="17" styleClass="secondary-icon"/>
                    <TextField fx:id="urlInput" promptText="https://example.com" HBox.hgrow="ALWAYS" styleClass="url-input" onAction="#analyzeManual" accessibleText="URL to analyze"/>
                    <Button fx:id="analyzeBtn" text="Analyze URL" onAction="#analyzeManual" styleClass="primary-button" accessibleText="Analyze entered URL"/>
                  </HBox>
                  <Label text="Only the URL is sent to the local Spring backend. Results and policy decisions come from the backend." styleClass="metric-note" wrapText="true"/>
                </VBox>
                <VBox fx:id="analysisLoading" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10" styleClass="result-panel">
                  <HBox alignment="CENTER_LEFT" spacing="12"><ProgressIndicator prefWidth="24" prefHeight="24" maxWidth="24" maxHeight="24"/><VBox spacing="3"><Label text="Analyzing URL securely" styleClass="section-heading"/><Label text="Waiting for the local security service…" styleClass="body-secondary"/></VBox></HBox>
                </VBox>
                <VBox fx:id="analysisError" visible="false" managed="false" spacing="10" styleClass="message-panel error-panel">
                  <Label fx:id="analysisErrorText" text="Unable to connect to AI WatchDog." styleClass="message-title" wrapText="true"/><Button text="Retry" onAction="#retryAnalysis" styleClass="quiet-button"/>
                </VBox>
                <VBox fx:id="analysisResult" visible="false" managed="false" spacing="18" styleClass="result-panel">
                  <HBox alignment="CENTER_LEFT" spacing="12"><StackPane fx:id="resultMark" styleClass="result-mark"><FontIcon fx:id="resultIcon" iconLiteral="fth-shield" iconSize="20" styleClass="result-icon"/></StackPane><VBox spacing="3"><Label text="BACKEND ASSESSMENT" styleClass="metric-caption"/><Label fx:id="resultDecision" text="ALLOW" styleClass="result-decision"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="resultRisk" text="SAFE" styleClass="risk-badge"/></HBox>
                  <Label fx:id="resultUrl" text="https://example.com" styleClass="result-url" wrapText="true"/>
                  <ProgressBar fx:id="resultScoreBar" progress="0" maxWidth="Infinity" styleClass="score-bar"/>
                  <HBox spacing="0" styleClass="result-facts">
                    <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="RISK SCORE" styleClass="metric-caption"/><Label fx:id="resultScore" text="— / 100" styleClass="fact-value"/></VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="PREDICTION" styleClass="metric-caption"/><Label fx:id="resultPrediction" text="—" styleClass="fact-value"/></VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="PHISHING PROBABILITY" styleClass="metric-caption"/><Label fx:id="resultProbability" text="—" styleClass="fact-value"/></VBox>
                  </HBox>
                  <VBox spacing="7"><Label text="Assessment details" styleClass="section-heading-small"/><Label fx:id="resultReason" text="" styleClass="body-secondary" wrapText="true"/></VBox>
                </VBox>
              </VBox>
            </content>
          </ScrollPane>

          <ScrollPane fx:id="historyPage" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
              <VBox spacing="18" styleClass="page-content">
                <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="5"><Label text="Security history" styleClass="page-heading"/><Label text="Recent URL analyses and file/process audit events." styleClass="body-secondary"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refreshData" styleClass="quiet-button"/></HBox>
                <HBox spacing="10" alignment="CENTER_LEFT"><Label text="FILTER" styleClass="metric-caption"/><ComboBox fx:id="riskFilter" promptText="All risks" prefWidth="160" accessibleText="Filter by risk"/><ComboBox fx:id="decisionFilter" promptText="All decisions" prefWidth="170" accessibleText="Filter by decision"/><Button text="Reset" onAction="#clearHistoryFilters" styleClass="text-button"/></HBox>
                <StackPane styleClass="event-list-panel" minHeight="320" VBox.vgrow="ALWAYS">
                  <ListView fx:id="historyList" styleClass="event-list" accessibleText="Security event history"/>
                  <VBox fx:id="historyEmptyState" visible="false" managed="false" alignment="CENTER" spacing="8" styleClass="empty-state"><FontIcon iconLiteral="fth-inbox" iconSize="24" styleClass="empty-icon"/><Label fx:id="historyEmptyTitle" text="No security events yet" styleClass="empty-title"/><Label fx:id="historyEmptyDetail" text="Recorded events will appear here." styleClass="body-secondary"/></VBox>
                  <ProgressIndicator fx:id="historyLoading" visible="false" managed="false" maxWidth="30" maxHeight="30"/>
                </StackPane>
                <Label fx:id="historyMessage" text="" styleClass="inline-message" wrapText="true"/>
                <Label text="Showing up to the latest 100 URL events and 100 monitor events returned by Spring." styleClass="metric-note"/>
              </VBox>
            </content>
          </ScrollPane>

          <ScrollPane fx:id="monitoringPage" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
              <VBox spacing="22" styleClass="page-content">
                <HBox alignment="CENTER_LEFT" spacing="14"><VBox spacing="5"><Label text="Monitoring" styleClass="page-heading"/><Label text="Current backend health and local observer state." styleClass="body-secondary"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="monitoringToggleBtn" text="Start local monitoring" onAction="#toggleMonitoring" styleClass="primary-button" accessibleText="Start or stop local file and process monitoring"/></HBox>
                <VBox styleClass="status-list-panel" spacing="0">
                  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="service-row"><StackPane styleClass="service-icon"><FontIcon iconLiteral="fth-server" iconSize="17"/></StackPane><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Spring Boot" styleClass="service-name"/><Label text="Application API and event history" styleClass="body-secondary"/></VBox><Region fx:id="monitorBackendDot" styleClass="status-dot status-pending"/><Label fx:id="monitorBackendStatus" text="Checking" styleClass="service-state"/></HBox>
                  <Separator/>
                  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="service-row"><StackPane styleClass="service-icon"><FontIcon iconLiteral="fth-cpu" iconSize="17"/></StackPane><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="FastAPI model service" styleClass="service-name"/><Label text="URL inference service health reported by Spring" styleClass="body-secondary"/></VBox><Region fx:id="monitorMlDot" styleClass="status-dot status-pending"/><Label fx:id="monitorMlStatus" text="Checking" styleClass="service-state"/></HBox>
                  <Separator/>
                  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="service-row"><StackPane styleClass="service-icon"><FontIcon iconLiteral="fth-folder" iconSize="17"/></StackPane><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="File observer" styleClass="service-name"/><Label fx:id="fileMonitorDetail" text="Starting local directory watcher" styleClass="body-secondary"/></VBox><Region fx:id="fileMonitorDot" styleClass="status-dot status-pending"/><Label fx:id="fileMonitorStatus" text="Starting" styleClass="service-state"/></HBox>
                  <Separator/>
                  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="service-row"><StackPane styleClass="service-icon"><FontIcon iconLiteral="fth-activity" iconSize="17"/></StackPane><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Process observer" styleClass="service-name"/><Label text="Process names and IDs only; command lines are not collected" styleClass="body-secondary"/></VBox><Region fx:id="processMonitorDot" styleClass="status-dot status-pending"/><Label fx:id="processMonitorStatus" text="Starting" styleClass="service-state"/></HBox>
                </VBox>
                <VBox styleClass="note-panel" spacing="7"><Label text="Collection scope" styleClass="section-heading-small"/><Label text="File monitoring reads names and sizes from configured user folders. Process monitoring records executable names and IDs. Both submit metadata to Spring for assessment. These observers record decisions; they do not prevent file access or stop processes." styleClass="body-secondary" wrapText="true"/></VBox>
                <Label fx:id="monitorMessage" text="" styleClass="inline-message" wrapText="true"/>
              </VBox>
            </content>
          </ScrollPane>

          <ScrollPane fx:id="settingsPage" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
              <VBox spacing="22" styleClass="page-content">
                <VBox spacing="5"><Label text="Settings" styleClass="page-heading"/><Label text="Appearance and local service configuration." styleClass="body-secondary"/></VBox>
                <VBox styleClass="settings-section" spacing="15"><VBox spacing="4"><Label text="Appearance" styleClass="section-heading"/><Label text="Choose a theme for this device. Your choice is saved locally." styleClass="body-secondary"/></VBox><HBox alignment="CENTER_LEFT" spacing="14"><Label text="Theme" styleClass="service-name"/><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="themeChoice" prefWidth="190" accessibleText="Application theme"/></HBox></VBox>
                <VBox styleClass="settings-section" spacing="15"><VBox spacing="4"><Label text="Connection" styleClass="section-heading"/><Label text="JavaFX communicates only with the Spring Boot API." styleClass="body-secondary"/></VBox><HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconLiteral="fth-link" iconSize="16" styleClass="secondary-icon"/><Label text="Backend address" styleClass="service-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="backendAddress" text="http://127.0.0.1:8080" styleClass="settings-value"/></HBox><HBox alignment="CENTER_LEFT" spacing="12"><Label text="Connection state" styleClass="service-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="settingsConnectionState" text="Checking" styleClass="service-state"/></HBox></VBox>
                <VBox styleClass="settings-section" spacing="9"><Label text="About AI WatchDog" styleClass="section-heading"/><Label text="Local Windows security monitoring prototype · JavaFX, Spring Boot, FastAPI, SQLite" styleClass="body-secondary" wrapText="true"/><Label text="URL decisions use the backend ML/policy path. File and process results are metadata heuristics, not malware scans or operating-system enforcement." styleClass="metric-note" wrapText="true"/></VBox>
              </VBox>
            </content>
          </ScrollPane>
        </StackPane>
      </center>
    </BorderPane>
  </center>
</BorderPane>
