                      </StackPane>
                      <Label fx:id="step4Label" text="AI model analysis" styleClass="wd-stp-label-pending"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="wd-stp-row">
                      <StackPane fx:id="step5IconBox" styleClass="wd-stp-box-pending">
