                      </HBox>
                      <ProgressBar fx:id="insightPatternBar2" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-blue"/>
                    </VBox>

                    <!-- IP-based URLs -->
                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT">
                        <Label text="URL user-info indicators" styleClass="feature-key" style="-fx-font-weight: 600;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="insightPattern3" text="0" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                      </HBox>
                      <ProgressBar fx:id="insightPatternBar3" progress="0" maxWidth="Infinity" styleClass="custom-progress-bar, bar-red"/>
