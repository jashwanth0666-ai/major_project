                    <Label text="Prediction" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="info-label"/>
                    <Label fx:id="resultPrediction" text="BENIGN" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="info-value" style="-fx-font-weight: 700; -fx-text-fill: #10B981;"/>

                    <Label text="Decision" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="info-label"/>
                    <Label fx:id="resultDecision" text="ALLOW" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="info-value" style="-fx-font-weight: 700; -fx-text-fill: #10B981;"/>

                    <Label text="Model phishing probability" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="info-label"/>
                    <Label fx:id="resultConfidence" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="info-value"/>
                    <Label text="Phishing label threshold" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="info-label"/>
                    <Label fx:id="resultThreshold" text="31%" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="info-value"/>
                  </GridPane>
                </HBox>
              </VBox>

              <!-- 3 Bottom Assessment Cards -->
