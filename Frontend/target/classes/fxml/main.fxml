              </VBox>

              <!-- Central Scanning Card -->
              <VBox styleClass="stitch-card" spacing="28" style="-fx-padding: 36px 32px;">
                <HBox spacing="40" alignment="CENTER">
                  <!-- Stepper on Left (6 rows) -->
                  <VBox spacing="9" prefWidth="230">
