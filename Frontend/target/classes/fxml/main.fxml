<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aiwatchdog.controller.MainController" styleClass="app-root">
  <VBox fx:id="welcomePage" alignment="CENTER" spacing="18" styleClass="welcome-page"><Label text="◈" styleClass="welcome-mark"/><Label text="AI WatchDog" styleClass="welcome-title"/><Label text="AI-Driven Phishing Detection &amp; Secure Access" styleClass="welcome-subtitle"/><Label text="PROTOTYPE SIMULATION  /  SECURITY INTELLIGENCE" styleClass="eyebrow"/><Label text="Intelligent protection for every website you visit." styleClass="welcome-copy"/><HBox spacing="8" styleClass="status-pill"><Label text="●"/><Label text="Protection engine ready"/></HBox><Button text="Start Protection  →" onAction="#startProtection" styleClass="primary-button"/><Label text="Academic demonstration prototype • no live browser interception" styleClass="muted"/></VBox>
  <VBox fx:id="setupPage" alignment="CENTER" spacing="20" styleClass="setup-page" visible="false"><Label text="Let's secure your browsing" styleClass="page-title"/><Label text="Configure three in-memory protection policies for this demo session." styleClass="page-subtitle"/><VBox styleClass="setup-card" spacing="16"><HBox spacing="14"><Label text="01" styleClass="step-number"/><VBox><Label text="URL Protection" styleClass="section-title"/><Label text="Inspect simulated browser events for phishing indicators." styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><HBox spacing="14"><Label text="02" styleClass="step-number"/><VBox><Label text="Secure Access" styleClass="section-title"/><Label text="Apply allow, warn, restrict, or block decisions." styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><HBox spacing="14"><Label text="03" styleClass="step-number"/><VBox><Label text="Threat Notifications" styleClass="section-title"/><Label text="Keep your security activity timeline current." styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox></VBox><Button text="Protection Ready  →" onAction="#completeSetup" styleClass="primary-button"/></VBox>
  <BorderPane fx:id="appShell" styleClass="shell" visible="false"><left><VBox styleClass="sidebar" spacing="8"><VBox styleClass="brand"><Label text="◈" styleClass="brand-mark"/><VBox><Label text="AI WatchDog" styleClass="brand-name"/></VBox></VBox><Label text="SECURITY WORKSPACE" styleClass="nav-label"/><Button text="Overview" onAction="#navigateDashboard" styleClass="nav-button"/><Button text="URL Scanner" onAction="#navigateScanner" styleClass="nav-button"/><Button text="Secure Access" onAction="#navigateDashboard" styleClass="nav-button"/><Button text="Threat Center" onAction="#navigateThreats" styleClass="nav-button"/><Button text="Activity" onAction="#navigateActivity" styleClass="nav-button"/><Button text="AI Insights" onAction="#navigateInsights" styleClass="nav-button"/><Button text="Settings" onAction="#navigateSettings" styleClass="nav-button"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="7" styleClass="demo-badge"><Label text="●"/><Label text="DEMO MODE  •  ENGINE ACTIVE"/></HBox></VBox></left><center><VBox><HBox alignment="CENTER_LEFT" styleClass="topbar"><VBox><Label text="Security overview" styleClass="top-title"/><Label text="Your system at a glance" styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><Label text="PROTECTED" styleClass="active-badge"/><Button text="Simulate Browser Event" onAction="#simulateRandom" styleClass="outline-button"/></HBox><StackPane fx:id="pageStack" styleClass="page-stack">
    <VBox fx:id="dashboardPage" spacing="16" styleClass="page"><HBox spacing="14"><VBox HBox.hgrow="ALWAYS" styleClass="hero-card"><Label text="PROTECTION ACTIVE" styleClass="eyebrow"/><Label text="Your system is actively protected" styleClass="hero-title"/><Label text="AI WatchDog evaluates simulated browser events with a transparent, deterministic demo engine." styleClass="muted" wrapText="true"/><Label text="●  Automatic protection enabled" styleClass="small-status"/></VBox><VBox prefWidth="225" styleClass="score-card"><Label text="FLEET RISK INDEX" styleClass="eyebrow"/><Label fx:id="dashboardScore" text="12 / 100" styleClass="score-number"/><ProgressBar progress="0.12" maxWidth="1.7976931348623157E308"/><Label text="Threat probability is negligible" styleClass="muted"/></VBox></HBox><HBox spacing="12"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="SCANNED URLS" styleClass="eyebrow"/><Label fx:id="scannedCount" text="1,284" styleClass="stat-number"/><Label text="This session" styleClass="muted"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="BLOCKED" styleClass="eyebrow"/><Label fx:id="blockedCount" text="37" styleClass="stat-number danger-text"/><Label text="Threats mitigated" styleClass="muted"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="ALLOWED" styleClass="eyebrow"/><Label text="1,221" styleClass="stat-number safe-text"/><Label text="Trusted destinations" styleClass="muted"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="SUSPICIOUS" styleClass="eyebrow"/><Label text="26" styleClass="stat-number warning-text"/><Label text="Needs attention" styleClass="muted"/></VBox></HBox><HBox spacing="14" VBox.vgrow="ALWAYS"><VBox styleClass="panel" HBox.hgrow="ALWAYS"><HBox><Label text="Live Browsing Protection" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="activityStatus" text="Realtime event bus connected" styleClass="muted"/></HBox><ListView fx:id="activityList" VBox.vgrow="ALWAYS"/></VBox><VBox prefWidth="260" styleClass="panel" spacing="10"><Label text="Quick Security Tools" styleClass="section-title"/><Label text="Run isolated demo assessments." styleClass="muted" wrapText="true"/><Button text="Simulate Safe URL" onAction="#simulateSafe" styleClass="safe-button"/><Button text="Simulate Suspicious URL" onAction="#simulateSuspicious" styleClass="warning-button"/><Button text="Simulate Phishing URL" onAction="#simulatePhishing" styleClass="danger-button"/></VBox></HBox></VBox>
    <VBox fx:id="scannerPage" visible="false" spacing="16" styleClass="page"><Label text="URL Scanner" styleClass="page-title"/><Label text="A manual secondary tool using the same prototype detection pipeline." styleClass="page-subtitle"/><HBox spacing="10" styleClass="search-row"><TextField fx:id="urlInput" promptText="https://example.com/login" HBox.hgrow="ALWAYS"/><Button text="Analyze URL" onAction="#analyzeManual" styleClass="primary-button"/></HBox><VBox styleClass="panel" spacing="10"><Label text="Demo URLs" styleClass="section-title"/><HBox spacing="10"><Button text="Safe" onAction="#simulateSafe" styleClass="safe-button"/><Button text="Suspicious" onAction="#simulateSuspicious" styleClass="warning-button"/><Button text="Phishing" onAction="#simulatePhishing" styleClass="danger-button"/></HBox></VBox></VBox>
    <VBox fx:id="analysisPage" visible="false" alignment="CENTER" spacing="18" styleClass="page"><Label text="AI MODEL CLASSIFICATION PIPELINE" styleClass="eyebrow"/><Label text="Analyzing detected URL" styleClass="page-title"/><Label fx:id="analysisUrl" styleClass="url-label"/><ProgressBar fx:id="analysisProgress" progress="0.2" prefWidth="460"/><Label fx:id="analysisStage" text="Extracting URL features..." styleClass="muted"/><VBox styleClass="analysis-stages"><Label text="✓  URL detected"/><Label text="✓  Features extracted"/><Label text="◌  Evaluating security indicators"/><Label text="○  Calculating risk and access decision"/></VBox></VBox>
    <VBox fx:id="resultPage" visible="false" spacing="16" styleClass="page"><Label text="SECURITY RESULT" styleClass="eyebrow"/><Label fx:id="resultTitle" text="ACCESS BLOCKED" styleClass="result-title"/><Label fx:id="resultSubtitle" text="Phishing website detected" styleClass="page-subtitle"/><HBox spacing="14"><VBox prefWidth="240" styleClass="score-card"><Label text="AI RISK SCORE" styleClass="eyebrow"/><Label fx:id="resultScore" text="94 / 100" styleClass="score-number danger-text"/><Label fx:id="resultDecision" text="ACCESS BLOCKED" styleClass="decision-label"/></VBox><VBox styleClass="panel" HBox.hgrow="ALWAYS"><Label text="Why this decision was made" styleClass="section-title"/><Label fx:id="resultReason" wrapText="true" styleClass="reason-text"/><Label text="Extracted features" styleClass="section-title"/><ListView fx:id="featureList" prefHeight="120"/></VBox></HBox><HBox spacing="10"><Button text="Return to Safety" onAction="#backToDashboard" styleClass="primary-button"/><Button fx:id="proceedButton" text="Proceed Anyway" onAction="#proceedAnyway" styleClass="outline-button"/></HBox></VBox>
    <VBox fx:id="threatsPage" visible="false" spacing="16" styleClass="page"><Label text="Threat Center" styleClass="page-title"/><Label text="Recent suspicious and blocked activity." styleClass="page-subtitle"/><VBox styleClass="panel" VBox.vgrow="ALWAYS"><HBox><Label text="Threat ledger" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="37 blocked" styleClass="danger-text"/></HBox><ListView fx:id="threatList" VBox.vgrow="ALWAYS"/></VBox></VBox>
    <VBox fx:id="activityPage" visible="false" spacing="16" styleClass="page"><Label text="Activity" styleClass="page-title"/><Label text="Chronological prototype security decisions." styleClass="page-subtitle"/><VBox styleClass="panel" VBox.vgrow="ALWAYS"><Label text="Event timeline" styleClass="section-title"/><Label text="The live dashboard stream is updated after every demo analysis." styleClass="muted"/><ListView VBox.vgrow="ALWAYS"/></VBox></VBox>
    <VBox fx:id="insightsPage" visible="false" spacing="16" styleClass="page"><Label text="AI Insights &amp; Detection Model Forensics" styleClass="page-title"/><Label text="Research-reference metrics are shown for demonstration only." styleClass="page-subtitle"/><HBox spacing="14"><VBox styleClass="panel" HBox.hgrow="ALWAYS"><Label text="ACTIVE MODEL" styleClass="eyebrow"/><Label text="Random Forest" styleClass="insight-value"/><Label text="Supervised Machine Learning" styleClass="muted"/><Label text="Reference model performance — research result" styleClass="reference-label"/><Label text="Accuracy 97.8%   Precision 98.1%   Recall 96.9%   F1 97.5%   AUC 0.99" styleClass="muted" wrapText="true"/></VBox><VBox styleClass="panel" HBox.hgrow="ALWAYS"><Label text="FEATURE IMPORTANCE" styleClass="section-title"/><Label text="URL Structure       ████████████"/><Label text="IP Address          ██████████"/><Label text="HTTPS               █████████"/><Label text="Keywords            ███████"/><Label text="Subdomains         █████"/></VBox></HBox><VBox styleClass="panel"><Label text="Technical detection pipeline" styleClass="section-title"/><Label text="Simulated browser event  →  Feature extraction  →  Demo engine  →  Risk engine  →  Access decision" styleClass="muted" wrapText="true"/></VBox></VBox>
    <VBox fx:id="settingsPage" visible="false" spacing="16" styleClass="page"><Label text="Settings" styleClass="page-title"/><Label text="Configure the in-memory prototype session." styleClass="page-subtitle"/><VBox styleClass="panel" spacing="14"><Label text="Protection" styleClass="section-title"/><HBox><Label text="URL Protection"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><HBox><Label text="Secure Access"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><HBox><Label text="Threat Notifications"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><HBox><Label text="Automatic Protection"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox><Separator/><Label text="Detection sensitivity: Balanced" styleClass="section-title"/><Label text="Mode: Normal User + Technical details in AI Insights" styleClass="muted"/></VBox></VBox>
  </StackPane></VBox></center></BorderPane>
  <Label fx:id="toast" text="Protection is active" visible="false" styleClass="toast" StackPane.alignment="BOTTOM_CENTER"/>
</StackPane>
