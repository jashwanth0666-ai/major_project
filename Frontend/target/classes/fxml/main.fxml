<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aiwatchdog.controller.MainController" styleClass="app-root">

  <VBox fx:id="welcomePage" alignment="CENTER" styleClass="welcome-page-new">
    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
      <ImageView fx:id="logoImage" fitWidth="320" preserveRatio="true">
        <image>
          <Image url="@../images/logo.png"/>
        </image>
      </ImageView>
      <Label text="AI WATCHDOG" styleClass="welcome-title-new"/>
      <Label text="SECURITY IN EVERY CLICK" styleClass="welcome-subtitle-new"/>
      <Region prefHeight="60"/>
    </VBox>
    <Button text="GET STARTED  -&gt;" onAction="#startProtection" styleClass="get-started-button"/>
    <Region prefHeight="50"/>
  </VBox>

  <VBox fx:id="setupPage" alignment="CENTER" spacing="20" styleClass="setup-page" visible="false">
    <VBox alignment="CENTER" spacing="12">
        <Label text="Initialization" styleClass="eyebrow-accent"/>
        <Label text="Secure Your Workspace" styleClass="page-title"/>
        <Label text="Review and activate protective boundaries before starting." styleClass="page-subtitle"/>
    </VBox>
    <VBox styleClass="setup-card" spacing="16">
      <HBox spacing="14" alignment="CENTER_LEFT" styleClass="setup-row">
        <Label text="01" styleClass="step-number"/>
        <VBox HBox.hgrow="ALWAYS">
          <Label text="Real-time URL Protection" styleClass="section-title"/>
          <Label text="Inspect network events for phishing indicators." styleClass="muted"/>
        </VBox>
        <CheckBox selected="true"/>
      </HBox>
      <HBox spacing="14" alignment="CENTER_LEFT" styleClass="setup-row">
        <Label text="02" styleClass="step-number"/>
        <VBox HBox.hgrow="ALWAYS">
          <Label text="Telemetry &amp; Alerts" styleClass="section-title"/>
          <Label text="Stream analytical indicators to the dashboard." styleClass="muted"/>
        </VBox>
        <CheckBox selected="true"/>
      </HBox>
    </VBox>
    <Button text="Activate Protection System" onAction="#completeSetup" styleClass="primary-button, large-button"/>
  </VBox>

  <BorderPane fx:id="appShell" styleClass="shell" visible="false">
    <left>
      <VBox styleClass="sidebar" spacing="8">
        <VBox styleClass="brand-container" alignment="CENTER_LEFT">
          <HBox spacing="10" alignment="CENTER_LEFT">
             <Label text="?" styleClass="brand-logo-icon"/>
             <Label text="AI WatchDog" styleClass="brand-name"/>
          </HBox>
          <Label text="ENTERPRISE EDITION" styleClass="brand-subtitle"/>
        </VBox>
        <VBox spacing="4" VBox.vgrow="ALWAYS" styleClass="nav-menu">
            <Label text="WORKSPACE" styleClass="nav-section-title"/>
            <Button text="Security Overview" onAction="#navigateDashboard" styleClass="nav-button, nav-active"/>
            <Button text="Threat Inspector" onAction="#navigateScanner" styleClass="nav-button"/>
            <Button text="Event Telemetry" onAction="#navigateActivity" styleClass="nav-button"/>
            <Button text="AI Risk Insights" onAction="#navigateInsights" styleClass="nav-button"/>
            
            <Region prefHeight="16"/>
            <Label text="ADMINISTRATION" styleClass="nav-section-title"/>
            <Button text="Policy Controls" onAction="#navigateSecurityControls" styleClass="nav-button"/>
            <Button text="System Settings" onAction="#navigateSettings" styleClass="nav-button"/>
        </VBox>
        <HBox spacing="8" styleClass="status-footer" alignment="CENTER_LEFT">
          <Region styleClass="pulse-indicator-active"/>
          <Label text="ENGINE ONLINE" styleClass="status-footer-text"/>
        </HBox>
      </VBox>
    </left>
    <center>
      <VBox>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
          <Label text="Security Overview" styleClass="topbar-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <HBox spacing="12" alignment="CENTER">
             <Label text="WORKSPACE PROTECTED" styleClass="badge, badge-safe"/>
             <Button text="Test Event Bus" onAction="#simulateRandom" styleClass="secondary-button"/>
          </HBox>
        </HBox>
        
        <StackPane fx:id="pageStack" styleClass="page-stack" VBox.vgrow="ALWAYS">
          
          <!-- Dashboard Page -->
          <VBox fx:id="dashboardPage" spacing="20" styleClass="page">
            <!-- Top Stats Row -->
            <HBox spacing="16">
              <VBox styleClass="hero-card, card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                   <Label text="PROTECTION ACTIVE" styleClass="eyebrow-safe"/>
                   <Region HBox.hgrow="ALWAYS"/>
                   <Region styleClass="pulse-indicator-active"/>
                </HBox>
                <Label text="Workspace is secured" styleClass="hero-title"/>
                <Label text="AI WatchDog is actively intercepting and analyzing background telemetry." styleClass="muted" wrapText="true"/>
              </VBox>
              <VBox styleClass="score-card, card" prefWidth="240">
                <Label text="FLEET RISK INDEX" styleClass="eyebrow"/>
                <Label fx:id="dashboardScore" text="0 / 100" styleClass="score-number"/>
                <ProgressBar progress="0.0" maxWidth="Double.MAX_VALUE" styleClass="risk-progress"/>
                <ProgressBar progress="0.0" maxWidth="Infinity" styleClass="risk-progress"/>
                <Label text="Awaiting data..." styleClass="muted"/>
              </VBox>
            </HBox>
            <!-- Secondary Stats -->
            <HBox spacing="16">
              <VBox styleClass="stat-card, card" HBox.hgrow="ALWAYS">
                <Label text="EVENTS INSPECTED" styleClass="eyebrow"/>
                <Label fx:id="scannedCount" text="0" styleClass="stat-number"/>
              </VBox>
              <VBox styleClass="stat-card, card" HBox.hgrow="ALWAYS">
                <Label text="THREATS BLOCKED" styleClass="eyebrow"/>
                <Label fx:id="blockedCount" text="0" styleClass="stat-number, text-danger"/>
              </VBox>
              <VBox styleClass="stat-card, card" HBox.hgrow="ALWAYS">
                <Label text="AI CONFIDENCE" styleClass="eyebrow"/>
                <Label text="98.2%" styleClass="stat-number, text-accent"/>
              </VBox>
            </HBox>
            <!-- Bottom Panels -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">
              <VBox styleClass="panel, card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label text="Recent Interceptions" styleClass="panel-title"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Label text="Live Feed" styleClass="eyebrow-accent"/>
                </HBox>
                <ListView fx:id="activityList" VBox.vgrow="ALWAYS" styleClass="clean-list"/>
              </VBox>
              <VBox prefWidth="280" styleClass="panel, card" spacing="12">
                <Label text="Simulation Tools" styleClass="panel-title"/>
                <Label text="Inject mock telemetry into the decision engine." styleClass="muted" wrapText="true"/>
                <Button text="Inject Clean Payload" onAction="#simulateSafe" styleClass="outline-button, w-full"/>
                <Button text="Inject Suspicious Signal" onAction="#simulateSuspicious" styleClass="outline-button, outline-warn, w-full"/>
                <Button text="Inject Malicious Exploit" onAction="#simulatePhishing" styleClass="outline-button, outline-danger, w-full"/>
              </VBox>
            </HBox>
          </VBox>

          <!-- Scanner Page -->
          <VBox fx:id="scannerPage" visible="false" spacing="20" styleClass="page">
            <VBox styleClass="card" spacing="16">
                <Label text="Threat Inspector" styleClass="page-title"/>
                <Label text="Manually submit a payload URL for AI verification." styleClass="page-subtitle"/>
                <HBox spacing="8" styleClass="search-bar-container">
                  <TextField fx:id="urlInput" promptText="https://..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                  <Button fx:id="analyzeBtn" text="Analyze Target" onAction="#analyzeManual" styleClass="primary-button"/>
                </HBox>
            </VBox>
            <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Quick Tests" styleClass="panel-title"/>
                <HBox spacing="12">
                  <Button text="Test Safe Target" onAction="#simulateSafe" styleClass="secondary-button"/>
                  <Button text="Test Suspicious Target" onAction="#simulateSuspicious" styleClass="secondary-button"/>
                </HBox>
            </VBox>
          </VBox>

          <!-- Analysis Loading Page -->
          <VBox fx:id="analysisPage" visible="false" alignment="CENTER" spacing="24" styleClass="page, loading-page">
            <ProgressIndicator fx:id="analysisProgress" prefWidth="64" prefHeight="64"/>
            <VBox alignment="CENTER" spacing="8">
                <Label text="ANALYZING TARGET" styleClass="eyebrow-accent"/>
                <Label fx:id="analysisUrl" text="..." styleClass="mono-title"/>
                <Label fx:id="analysisStage" text="Establishing secure connection..." styleClass="muted"/>
            </VBox>
          </VBox>

          <!-- Result Page -->
          <VBox fx:id="resultPage" visible="false" spacing="20" styleClass="page">
            <HBox spacing="16">
              <VBox styleClass="card, result-hero" prefWidth="280" alignment="CENTER" spacing="12">
                <Label text="SYSTEM DECISION" styleClass="eyebrow"/>
                <Label fx:id="resultTitle" text="DECISION" styleClass="result-decision-text"/>
                <Label fx:id="resultDecision" text="Policy Decision Details" styleClass="muted, text-center" wrapText="true"/>
              </VBox>
              <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                <Label text="AI Risk Assessment" styleClass="panel-title"/>
                <Label fx:id="resultSubtitle" text="Prediction details" styleClass="hero-title"/>
                <HBox spacing="24">
                   <VBox>
                      <Label text="RISK SCORE" styleClass="eyebrow"/>
                      <Label fx:id="resultScore" text="0 / 100" styleClass="mono-metric"/>
                   </VBox>
                   <VBox>
                      <Label text="THREAT ENGINE" styleClass="eyebrow"/>
                      <Label text="Ensemble v2.4" styleClass="mono-metric"/>
                   </VBox>
                </HBox>
                <Separator/>
                <Label text="Diagnostic Traces" styleClass="eyebrow"/>
                <Label fx:id="resultReason" wrapText="true" styleClass="mono-text"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Button text="? Return to Workspace" onAction="#backToDashboard" styleClass="secondary-button"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Button fx:id="proceedButton" text="Bypass Restriction (Admin)" onAction="#proceedAnyway" styleClass="destructive-button"/>
            </HBox>
          </VBox>

          <!-- Other Pages Skeleton -->
          <VBox fx:id="activityPage" visible="false" spacing="20" styleClass="page">
            <Label text="Event Telemetry" styleClass="page-title"/>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
                <Label text="Backend event storage is not currently implemented." styleClass="muted"/>
                <ListView fx:id="threatList" VBox.vgrow="ALWAYS" styleClass="clean-list"/>
            </VBox>
          </VBox>

          <VBox fx:id="insightsPage" visible="false" spacing="20" styleClass="page">
            <Label text="AI Risk Insights" styleClass="page-title"/>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" alignment="CENTER">
                <Label text="Telemetry API required for visualizations." styleClass="muted"/>
            </VBox>
          </VBox>

          <VBox fx:id="settingsPage" visible="false" spacing="20" styleClass="page">
            <Label text="System Settings" styleClass="page-title"/>
            <VBox styleClass="card" spacing="16">
              <Label text="General Protection Controls" styleClass="panel-title"/>
              <HBox styleClass="setup-row"><Label text="Active Deep Inspection"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox>
              <HBox styleClass="setup-row"><Label text="Report Telemetry Anonymously"/><Region HBox.hgrow="ALWAYS"/><CheckBox selected="true"/></HBox>
            </VBox>
          </VBox>

          <VBox fx:id="errorPage" visible="false" alignment="CENTER" spacing="20" styleClass="page">
            <Label text="SYSTEM FAULT" styleClass="eyebrow-danger"/>
            <Label text="Connection Failed" styleClass="page-title"/>
            <Label fx:id="errorMessageLabel" text="Backend engine unreachable." styleClass="mono-text"/>
            <Button text="Retry Connection" onAction="#retryConnection" styleClass="primary-button"/>
          </VBox>

        </StackPane>
      </VBox>
    </center>
  </BorderPane>
  
  <Label fx:id="toast" text="Notification" visible="false" styleClass="toast" StackPane.alignment="BOTTOM_CENTER"/>
</StackPane>