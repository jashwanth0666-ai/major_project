                      </StackPane>
                      <Label fx:id="step6Label" text="Finalizing result" styleClass="wd-stp-label-pending"/>
                    </HBox>
                  </VBox>

                  <!-- Radar Scanner Center Visual -->
                  <VBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="radarContainer" prefWidth="276" prefHeight="276" minWidth="276" minHeight="276" maxWidth="276" maxHeight="276">
                      <!-- Legacy node references retained for backwards compatibility -->
                      <Group visible="false" managed="false">
                        <Circle radius="110" styleClass="radar-ring"/>
                        <Circle radius="80" styleClass="radar-ring"/>
                        <Circle radius="50" styleClass="radar-ring"/>
                        <Group fx:id="radarSweepContainer">
                          <Circle radius="110" fill="transparent"/>
                          <Arc fx:id="radarSweepArc" radiusX="110" radiusY="110" startAngle="0" length="50" type="ROUND" styleClass="radar-sweep-cone"/>
                          <Arc radiusX="110" radiusY="110" startAngle="0" length="50" type="OPEN" styleClass="radar-outer-sweep-arc"/>
                          <Circle centerX="70.71" centerY="-84.26" radius="4" styleClass="radar-endpoint-marker"/>
                        </Group>
                        <StackPane fx:id="orbitIcon1"/>
                        <StackPane fx:id="orbitIcon2"/>
                        <StackPane fx:id="orbitIcon3"/>
                        <StackPane fx:id="orbitIcon4"/>
                        <StackPane fx:id="radarCenterShield"/>
                      </Group>
                    </StackPane>

                    <Label fx:id="scanStatusText" text="Initializing scan..." styleClass="wd-stg, wd-scan-status"/>

                    <HBox alignment="CENTER" spacing="12" maxWidth="320">
                      <ProgressBar fx:id="scanProgressBar" progress="0.0" prefWidth="116" maxWidth="116" minWidth="116" prefHeight="8" minHeight="8" maxHeight="8" styleClass="custom-progress-bar, bar-green"/>
                      <Label fx:id="scanPercentLabel" text="0%" styleClass="wd-pc"/>
                    </HBox>
                  </VBox>

                  <!-- Right Info Panel -->
                  <VBox spacing="16" prefWidth="240">
                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-file-text" iconSize="14" iconColor="#2563EB"/>
                        <Label text="URL" styleClass="info-label"/>
                      </HBox>
                      <Label fx:id="analyzingUrlText" text="https://www.example.com" styleClass="info-value" wrapText="true"/>
                    </VBox>

                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-shield" iconSize="14" iconColor="#2563EB"/>
                        <Label text="SCAN TYPE" styleClass="info-label"/>
                      </HBox>
                      <Label text="Full Analysis" styleClass="info-value"/>
                    </VBox>

                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-lock" iconSize="14" iconColor="#2563EB"/>
                        <Label text="SECURITY LAYERS" styleClass="info-label"/>
                      </HBox>
                      <Label text="5 AI Models" styleClass="info-value"/>
                    </VBox>

                    <VBox spacing="4">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-clock" iconSize="14" iconColor="#2563EB"/>
                        <Label text="ESTIMATED TIME" styleClass="info-label"/>
                      </HBox>
                      <Label text="2-5 seconds" styleClass="info-value"/>
                    </VBox>
                  </VBox>
                </HBox>
              </VBox>

              <!-- Did you know tip banner -->
              <HBox alignment="CENTER_LEFT" spacing="14" styleClass="stitch-card" style="-fx-padding: 16px 20px;">
                <StackPane styleClass="metric-icon-circle, icon-blue-bg" prefWidth="32" prefHeight="32" minWidth="32" minHeight="32">
                  <FontIcon iconLiteral="fth-cpu" iconSize="16" iconColor="#2563EB"/>
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                  <Label text="Did you know?" styleClass="wd-section-sub-title"/>
                  <Label text="AI WatchDog uses multiple AI models to detect phishing, malware and suspicious behavior in real-time." styleClass="page-header-subtitle"/>
                </VBox>
              </HBox>

              <Label text="&quot;Smarter Browsing. Safer You.&quot;" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8; -fx-alignment: center; -fx-font-style: italic;" maxWidth="Infinity"/>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 4. SECURITY ANALYSIS RESULT (STITCH SCREEN 3)                -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="resultPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <!-- Header with Action Buttons -->
              <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                  <Label text="Security Analysis Result" styleClass="page-header-title"/>
                  <Label text="Detailed assessment of the submitted website." styleClass="page-header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10">
                  <Button text="Scan Another URL" onAction="#scanAnotherUrl" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary">
                    <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="14" styleClass="stitch-btn-icon"/></graphic>
                  </Button>
                  <Button text="+ Back to Dashboard" onAction="#backToDashboard" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary"/>
                </HBox>
              </HBox>

              <!-- Top Result Overview Card -->
              <VBox styleClass="stitch-card" spacing="16">
                <HBox spacing="28" alignment="CENTER_LEFT">
                  <!-- Result Badge -->
                  <HBox fx:id="resultHeroBox" alignment="CENTER_LEFT" spacing="16" prefWidth="260">
                    <StackPane fx:id="resultIconContainer" prefWidth="46" prefHeight="46" minWidth="46" minHeight="46" style="-fx-background-color: #10B981; -fx-background-radius: 12px; -fx-alignment: center;">
                      <FontIcon fx:id="resultHeroIcon" iconLiteral="fth-check" iconSize="22" iconColor="#FFFFFF"/>
                    </StackPane>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                      <Label fx:id="resultTitle" text="SAFE" styleClass="result-title-text"/>
                      <Label fx:id="resultSubtitle" text="This website is safe to visit." styleClass="result-sub-text"/>
                    </VBox>
                  </HBox>

                  <Separator orientation="VERTICAL" style="-fx-opacity: 0.5;"/>

                  <!-- True Circular Gauge in Result Screen -->
                  <StackPane styleClass="gauge-container" minWidth="130" minHeight="130" prefWidth="130" prefHeight="130" maxWidth="130" maxHeight="130" alignment="CENTER">
                    <Group>
                      <Circle radius="52" styleClass="gauge-bg-circle"/>
                      <Arc fx:id="resultScoreArc" radiusX="52" radiusY="52" startAngle="90" length="-43.2" type="OPEN" styleClass="gauge-arc-fill"/>
                    </Group>
                    <VBox alignment="CENTER" spacing="1">
                      <Label fx:id="resultScoreNumber" text="12" styleClass="gauge-score-text" style="-fx-font-size: 26px; -fx-font-weight: 800;"/>
                      <Label text="/100" styleClass="gauge-score-sub" style="-fx-font-size: 11px;"/>
                      <Label fx:id="resultScorePill" text="RISK SCORE" styleClass="pill-badge, badge-safe" style="-fx-font-size: 8px; -fx-padding: 1px 6px;"/>
                    </VBox>
                  </StackPane>

                  <Separator orientation="VERTICAL" style="-fx-opacity: 0.5;"/>

                  <!-- Key Value Details -->
                  <GridPane hgap="24" vgap="12" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="30"/>
                      <ColumnConstraints percentWidth="70"/>
                    </columnConstraints>
                    
                    <Label text="URL" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="info-label"/>
                    <Label fx:id="resultUrl" text="https://www.google.com" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="info-value" style="-fx-font-family: monospace;"/>

                    <Label text="Prediction" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="info-label"/>
                    <Label fx:id="resultPrediction" text="BENIGN" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="info-value" style="-fx-font-weight: 700; -fx-text-fill: #10B981;"/>

                    <Label text="Decision" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="info-label"/>
                    <Label fx:id="resultDecision" text="ALLOW" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="info-value" style="-fx-font-weight: 700; -fx-text-fill: #10B981;"/>

                    <Label text="Phishing Probability" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="info-label"/>
                    <Label fx:id="resultConfidence" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="info-value"/>
                  </GridPane>
                </HBox>
              </VBox>

              <!-- 3 Bottom Assessment Cards -->
              <GridPane hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="38"/>
                  <ColumnConstraints percentWidth="38"/>
                  <ColumnConstraints percentWidth="24"/>
                </columnConstraints>

                <!-- Why this result? -->
                <VBox GridPane.columnIndex="0" styleClass="stitch-card" spacing="12">
                  <Label text="Why this result?" styleClass="panel-title" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>
                  <VBox fx:id="reasonsListContainer" spacing="10"/>
                </VBox>

                <!-- Extracted Features -->
                <VBox GridPane.columnIndex="1" styleClass="stitch-card" spacing="12">
                  <Label text="Extracted Features" styleClass="panel-title" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>
                  <VBox spacing="9">
                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="URL Length" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featUrlLength" text="—" styleClass="feature-val"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="Has HTTPS" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featHasHttps" text="—" styleClass="feature-val"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="Number of Dots" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featDotCount" text="—" styleClass="feature-val"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="Domain Age" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featDomainAge" text="—" styleClass="feature-val"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="Suspicious Keywords" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featKeywords" text="—" styleClass="feature-val"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                      <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-check" iconSize="14" iconColor="#10B981"/>
                        <Label text="IP Address Used" styleClass="feature-key"/>
                      </HBox>
                      <Region HBox.hgrow="ALWAYS"/>
                      <Label fx:id="featIpUsed" text="—" styleClass="feature-val"/>
                    </HBox>
                  </VBox>
                </VBox>

                <!-- Risk Level Scale -->
                <VBox GridPane.columnIndex="2" styleClass="stitch-card" spacing="14">
                  <Label text="Risk Level" styleClass="panel-title" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>
                  <VBox spacing="10">
                    <HBox fx:id="riskLevelHighBadge" alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4px 8px; -fx-background-radius: 6px;">
                      <Circle radius="4" fill="#EF4444"/>
                      <Label text="High Risk" styleClass="feature-key"/>
                    </HBox>

                    <HBox fx:id="riskLevelSuspiciousBadge" alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4px 8px; -fx-background-radius: 6px;">
                      <Circle radius="4" fill="#F59E0B"/>
                      <Label text="Suspicious" styleClass="feature-key"/>
                    </HBox>

                    <HBox fx:id="riskLevelLowBadge" alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4px 8px; -fx-background-radius: 6px;">
                      <Circle radius="4" fill="#10B981"/>
                      <Label text="Low Risk" styleClass="feature-key"/>
                    </HBox>

                    <HBox fx:id="riskLevelSafeBadge" alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4px 8px; -fx-background-radius: 6px;">
                      <Circle radius="4" fill="#14B8A6"/>
                      <Label text="Safe" styleClass="feature-key"/>
                    </HBox>
                  </VBox>
                </VBox>
              </GridPane>

              <!-- Bottom Banner -->
              <HBox fx:id="resultBanner" alignment="CENTER_LEFT" spacing="10" styleClass="banner-safe">
                <FontIcon fx:id="resultBannerIcon" iconLiteral="fth-check-circle" iconSize="16" iconColor="#059669"/>
                <Label fx:id="resultBannerText" text="This website appears safe. You can proceed with confidence." styleClass="banner-text-safe"/>
              </HBox>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 4B. SCAN ERROR SCREEN (WHEN BACKEND IS UNAVAILABLE)          -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="scanErrorPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <Button text="â† Back to URL Scanner" onAction="#navigateScanner" styleClass="wd-btn, wd-ghost, wd-btn--ghost, wd-btn--back" style="-fx-cursor: hand; -fx-padding: 4px 8px;"/>

              <VBox styleClass="stitch-card" spacing="20" alignment="CENTER" style="-fx-padding: 48px 32px;">
                <StackPane styleClass="metric-icon-circle, icon-red-bg" prefWidth="54" prefHeight="54" minWidth="54" minHeight="54">
                  <FontIcon iconLiteral="fth-wifi-off" iconSize="26" iconColor="#EF4444"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="6">
                  <Label text="Security Analysis Service Unavailable" styleClass="page-header-title" style="-fx-font-size: 18px;"/>
                  <Label fx:id="scanErrorUrl" text="Target URL: https://..." styleClass="breakdown-sub" style="-fx-font-family: monospace;"/>
                  <Label fx:id="scanErrorMessage" text="Unable to connect to the security analysis backend at http://localhost:8080/api/v1/analyze. Please ensure the Spring Boot backend service is running." styleClass="page-header-subtitle" wrapText="true" maxWidth="560" style="-fx-text-alignment: center;"/>
                </VBox>
                <HBox spacing="12" alignment="CENTER">
                  <Button text="Back to Scanner" onAction="#navigateScanner" styleClass="stitch-btn-secondary, wd-btn, wd-secondary, wd-btn--secondary"/>
                  <Button text="Retry Analysis" onAction="#retryLastScan" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary, wd-btn--spin">
                    <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="14" iconColor="#FFFFFF"/></graphic>
                  </Button>
                </HBox>
              </VBox>
            </VBox>
          </ScrollPane>

          <!-- ============================================================ -->
          <!-- 5. THREAT CENTER (STITCH SCREEN 4)                           -->
          <!-- ============================================================ -->
          <ScrollPane fx:id="threatCenterPage" visible="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane, wd-scroll">
            <VBox spacing="20" style="-fx-padding: 0 28px 28px 28px;">
              <!-- Header -->
              <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                  <Label text="Threat Center" styleClass="page-header-title"/>
                  <Label text="Monitor recent suspicious and blocked activity." styleClass="page-header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER">
                  <ComboBox fx:id="threatTimeFilter" promptText="Last 7 days" styleClass="stitch-combo-box"/>
                  <Button text="+ Export Report" onAction="#exportReport" styleClass="stitch-btn-primary, wd-btn, wd-primary, wd-btn--primary"/>
                </HBox>
              </HBox>

              <!-- 4 Metric Cards -->
              <GridPane hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                  <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <!-- High Risk Threats -->
                <VBox fx:id="threatCard0" GridPane.columnIndex="0" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="threatTile0" styleClass="metric-icon-circle, icon-red-bg">
                      <FontIcon fx:id="threatIcon0" iconLiteral="fth-alert-triangle" iconSize="18" iconColor="#EF4444"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="threatBlockedCount" text="—" styleClass="metric-value"/>
                  <Label text="High Risk Threats" styleClass="metric-label"/>
                  <Label fx:id="threatTrend0" text="No trend data" styleClass="metric-trend-red"/>
                </VBox>

                <!-- Potential Risk (In Review) -->
                <VBox fx:id="threatCard1" GridPane.columnIndex="1" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="threatTile1" styleClass="metric-icon-circle, icon-amber-bg">
                      <FontIcon fx:id="threatIcon1" iconLiteral="fth-target" iconSize="18" iconColor="#F59E0B"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="threatInReviewCount" text="—" styleClass="metric-value"/>
                  <Label text="Potential Risk" styleClass="metric-label"/>
                  <Label fx:id="threatTrend1" text="No trend data" styleClass="metric-trend-amber"/>
                </VBox>

                <!-- Suspicious Links -->
                <VBox fx:id="threatCard2" GridPane.columnIndex="2" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="threatTile2" styleClass="metric-icon-circle, icon-blue-bg">
                      <FontIcon fx:id="threatIcon2" iconLiteral="fth-alert-circle" iconSize="18" iconColor="#3B82F6"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="threatHighRiskCount" text="—" styleClass="metric-value"/>
                  <Label text="Suspicious Links" styleClass="metric-label"/>
                  <Label fx:id="threatTrend2" text="No trend data" styleClass="metric-trend-amber"/>
                </VBox>

                <!-- Safe / Allowed -->
                <VBox fx:id="threatCard3" GridPane.columnIndex="3" styleClass="metric-card">
                  <HBox alignment="CENTER_LEFT">
                    <StackPane fx:id="threatTile3" styleClass="metric-icon-circle, icon-green-bg">
                      <FontIcon fx:id="threatIcon3" iconLiteral="fth-check-circle" iconSize="18" iconColor="#16C784"/>
                    </StackPane>
                  </HBox>
                  <Label fx:id="threatSafeCount" text="—" styleClass="metric-value"/>
                  <Label text="Safe / Allowed" styleClass="metric-label"/>
                  <Label fx:id="threatTrend3" text="No trend data" styleClass="metric-trend-up"/>
                </VBox>
              </GridPane>

              <!-- Main Threat Content: Recent Threats (Left) & Insights (Right) -->
              <GridPane hgap="16" vgap="16">
                <columnConstraints>
                  <ColumnConstraints percentWidth="64"/>
                  <ColumnConstraints percentWidth="36"/>
                </columnConstraints>

                <!-- Recent Threats Table -->
                <VBox GridPane.columnIndex="0" styleClass="stitch-card" spacing="14">
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Recent Threats" styleClass="panel-title" style="-fx-font-size: 15px; -fx-font-weight: 700;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Real-time feed" styleClass="breakdown-sub"/>
                  </HBox>

                  <!-- Table Header -->
                  <HBox styleClass="table-header-row" alignment="CENTER_LEFT">
                    <Label text="URL" prefWidth="260" styleClass="table-header-label"/>
                    <Label text="RISK LEVEL" prefWidth="120" styleClass="table-header-label"/>
                    <Label text="DECISION" prefWidth="100" styleClass="table-header-label"/>
                    <Label text="TIME" prefWidth="80" styleClass="table-header-label"/>
                  </HBox>

                  <!-- Dynamic Threat Rows Container -->
                  <VBox fx:id="threatTableContainer" spacing="2"/>
                </VBox>

                <!-- Right Column: Threat Insights & Security Recommendation -->
                <VBox GridPane.columnIndex="1" spacing="16">
                  <!-- Threat Insights Donut -->
                  <VBox fx:id="threatInsightsCard" styleClass="stitch-card" spacing="14" style="-fx-cursor: hand;">
                    <Label text="Threat Insights" styleClass="panel-title" style="-fx-font-size: 15px; -fx-font-weight: 700;"/>

                    <HBox alignment="CENTER" spacing="24">
                      <!-- Donut -->
                      <StackPane fx:id="threatDonutPane" prefWidth="130" prefHeight="130" alignment="CENTER" style="-fx-cursor: hand;">
                        <Group>
                          <Circle fx:id="threatTrackCircle" radius="50" styleClass="wd-threat-donut-track"/>
                          <Arc fx:id="threatArcHigh" radiusX="50" radiusY="50" startAngle="90" length="-144" type="OPEN" style="-fx-fill: transparent; -fx-stroke: #EF4444; -fx-stroke-width: 14; -fx-cursor: hand;"/>
                          <Arc fx:id="threatArcSuspicious" radiusX="50" radiusY="50" startAngle="-54" length="-126" type="OPEN" style="-fx-fill: transparent; -fx-stroke: #F59E0B; -fx-stroke-width: 14; -fx-cursor: hand;"/>
                          <Arc fx:id="threatArcInfo" radiusX="50" radiusY="50" startAngle="-180" length="-90" type="OPEN" style="-fx-fill: transparent; -fx-stroke: #3B82F6; -fx-stroke-width: 14; -fx-cursor: hand;"/>
                        </Group>
                        <VBox alignment="CENTER" spacing="1">
                          <Label fx:id="threatTotalCountLabel" text="—" styleClass="wd-threat-donut-count"/>
                          <Label fx:id="threatTotalSubLabel" text="Total threats" styleClass="wd-threat-donut-sub"/>
                        </VBox>
                      </StackPane>

                      <!-- Legend -->
                      <VBox spacing="6" alignment="CENTER_LEFT" minWidth="150" prefWidth="160">
                        <HBox fx:id="threatLegendHigh" alignment="CENTER_LEFT" spacing="8" styleClass="wd-threat-legend-row">
                          <Circle radius="4" fill="#EF4444"/>
                          <Label text="High Risk" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Label fx:id="threatLegendHighPct" text="—" styleClass="wd-threat-legend-pct"/>
                        </HBox>
                        <HBox fx:id="threatLegendSusp" alignment="CENTER_LEFT" spacing="8" styleClass="wd-threat-legend-row">
                          <Circle radius="4" fill="#F59E0B"/>
                          <Label text="Suspicious" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Label fx:id="threatLegendSuspPct" text="—" styleClass="wd-threat-legend-pct"/>
                        </HBox>
                        <HBox fx:id="threatLegendInfo" alignment="CENTER_LEFT" spacing="8" styleClass="wd-threat-legend-row">
                          <Circle radius="4" fill="#3B82F6"/>
                          <Label text="Info" styleClass="metric-label" style="-fx-font-weight: 600;"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Label fx:id="threatLegendInfoPct" text="—" styleClass="wd-threat-legend-pct"/>
                        </HBox>
                      </VBox>
                    </HBox>
                  </VBox>

                  <!-- Security Recommendation -->
                  <VBox styleClass="stitch-card" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                      <StackPane styleClass="metric-icon-circle, icon-amber-bg" prefWidth="30" prefHeight="30">
                        <FontIcon iconLiteral="fth-shield" iconSize="15" iconColor="#F59E0B"/>
                      </StackPane>
                      <Label text="Security Recommendation" styleClass="wd-section-sub-title"/>
