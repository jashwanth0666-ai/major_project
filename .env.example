# Optional cloud explanation layer (server-side only).
AIWATCHDOG_LLM_ENABLED=false
AIWATCHDOG_LLM_API_KEY=
AIWATCHDOG_LLM_MODEL=openai/gpt-oss-120b
AIWATCHDOG_LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AIWATCHDOG_LLM_TIMEOUT_MS=3000

# Optional hostname-only adapter, or set provider=google-safe-browsing-v5 for URL-level checks.
# Google Safe Browsing receives the sanitized URL path; query, user info, and fragment are omitted.
AI_WATCHDOG_URL_REPUTATION_ENABLED=false
AI_WATCHDOG_URL_REPUTATION_ENDPOINT=
AI_WATCHDOG_URL_REPUTATION_API_KEY=
AI_WATCHDOG_URL_REPUTATION_PROVIDER=configured-url-provider
AI_WATCHDOG_URL_REPUTATION_TIMEOUT_MS=3000
AI_WATCHDOG_URL_REPUTATION_CACHE_TTL_SECONDS=300
AI_WATCHDOG_URL_REPUTATION_REQUESTS_PER_MINUTE=30
